{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dotnet: build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/HexTail.slnx"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/src/HexTail.Tests/HexTail.Tests.csproj"],
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: publish desktop",
      "type": "process",
      "command": "dotnet",
      "args": ["publish", "${workspaceFolder}/src/HexTail/HexTail.csproj", "-c", "Release"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: run desktop",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/src/HexTail/HexTail.csproj"],
      "problemMatcher": "$msCompile"
    }
  ]
}
