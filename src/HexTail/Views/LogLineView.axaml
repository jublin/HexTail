<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:HexTail.ViewModels"
  xmlns:views="using:HexTail.Views"
  xmlns:ic="https://github.com/projektanker/icons.avalonia"
  x:Class="HexTail.Views.LogLineView"
  x:DataType="vm:LogLineViewModel"
>
  <UserControl.ContextMenu>
    <ContextMenu Opening="OnContextMenuOpening">
      <MenuItem x:Name="InspectRow" Header="Inspect" InputGesture="Enter" Click="OnInspect" />
      <MenuItem
        x:Name="CopyRawLine"
        Header="Copy raw line"
        InputGesture="Ctrl+C"
        Click="OnCopyRawLine"
      />
      <MenuItem
        x:Name="ToggleBookmarkRow"
        Header="Toggle bookmark"
        InputGesture="M"
        Click="OnToggleBookmark"
      />
      <MenuItem
        Header="Copy fields"
        InputGesture="Ctrl+Shift+C"
        IsEnabled="{Binding HasParsedFields}"
        Click="OnCopyFields"
      />
    </ContextMenu>
  </UserControl.ContextMenu>
  <Border
    Background="{Binding Background}"
    BorderBrush="{DynamicResource BorderBrush}"
    BorderThickness="0,0,0,1"
    Padding="{Binding RowPadding}"
    Tapped="OnTapped"
    DoubleTapped="OnDoubleTapped"
  >
    <Grid ColumnDefinitions="Auto,*">
      <ic:Icon
        x:Name="BookmarkGlyph"
        Value="mdi-bookmark"
        Foreground="{DynamicResource AccentBrush}"
        IsVisible="{Binding IsBookmarked}"
        VerticalAlignment="Center"
        Margin="0,0,6,0"
      />
      <views:HighlightedTextBlock
        x:Name="ComposedText"
        Grid.Column="1"
        Text="{Binding Line.Raw}"
        Spans="{Binding Spans}"
        IsVisible="{Binding !UsesColumns}"
        FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
        FontSize="{Binding FontSize}"
        Foreground="{Binding Foreground}"
        TextWrapping="NoWrap"
        TextTrimming="CharacterEllipsis"
      />
      <ItemsControl
        x:Name="RowCells"
        Grid.Column="1"
        ItemsSource="{Binding Cells}"
        IsVisible="{Binding UsesColumns}"
        FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
        FontSize="{Binding FontSize}"
        Foreground="{Binding Foreground}"
      >
        <ItemsControl.Styles>
          <Style Selector="ContentPresenter">
            <Setter Property="DockPanel.Dock" Value="Left" />
          </Style>
        </ItemsControl.Styles>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <DockPanel LastChildFill="True" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LogCellViewModel">
            <views:HighlightedTextBlock
              Classes="cell"
              Classes.dimmed="{Binding IsDimmed}"
              Classes.trc="{Binding IsTraceLevel}"
              Classes.dbg="{Binding IsDebugLevel}"
              Classes.inf="{Binding IsInfoLevel}"
              Classes.wrn="{Binding IsWarnLevel}"
              Classes.err="{Binding IsErrorLevel}"
              Text="{Binding Text}"
              Spans="{Binding Spans}"
              Width="{Binding RenderWidth}"
              Padding="0,0,8,0"
              ToolTip.Tip="{Binding ToolTip}"
              TextWrapping="NoWrap"
              TextTrimming="CharacterEllipsis"
            />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Border>
</UserControl>
