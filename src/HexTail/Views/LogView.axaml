<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:HexTail.ViewModels"
  xmlns:views="using:HexTail.Views"
  HorizontalAlignment="Stretch"
  HorizontalContentAlignment="Stretch"
  VerticalContentAlignment="Stretch"
  VerticalAlignment="Stretch"
  x:Class="HexTail.Views.LogView"
  x:DataType="vm:LogViewViewModel"
>
  <Grid x:Name="LogLayout" Background="{DynamicResource SurfaceBrush}">
    <ListBox
      x:Name="LogList"
      Background="{DynamicResource SurfaceBrush}"
      BorderThickness="0"
      ItemsSource="{Binding Lines}"
    >
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:LogLineViewModel">
          <views:LogLineView />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Button
      x:Name="JumpToLatestButton"
      Classes="primary"
      HorizontalAlignment="Center"
      VerticalAlignment="Bottom"
      Margin="0,0,0,12"
      IsVisible="{Binding HasUnseen}"
      Content="{Binding UnseenLabel}"
      Command="{Binding JumpToLatestCommand}"
      AutomationProperties.Name="Jump to latest log lines"
    />
  </Grid>
</UserControl>
