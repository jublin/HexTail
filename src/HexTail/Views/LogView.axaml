<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:HexTail.ViewModels"
  xmlns:views="using:HexTail.Views"
  HorizontalAlignment="Stretch"
  HorizontalContentAlignment="Stretch"
  VerticalContentAlignment="Stretch"
  VerticalAlignment="Stretch"
  x:Class="HexTail.Views.LogView"
  x:DataType="vm:LogViewViewModel"
>
  <Grid
    x:Name="LogLayout"
    RowDefinitions="Auto,*"
    Background="{DynamicResource SurfaceBrush}"
  >
    <views:ColumnHeaderBar x:Name="ColumnHeader" DataContext="{Binding ColumnHeader}" />
    <ListBox
      x:Name="LogList"
      Grid.Row="1"
      Background="{DynamicResource SurfaceBrush}"
      BorderThickness="0"
      ItemsSource="{Binding Lines}"
    >
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:LogLineViewModel">
          <views:LogLineView />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Button
      x:Name="JumpToLatestButton"
      Grid.Row="1"
      Classes="primary"
      HorizontalAlignment="Center"
      VerticalAlignment="Bottom"
      Margin="0,0,0,12"
      IsVisible="{Binding HasUnseen}"
      Content="{Binding UnseenLabel}"
      Command="{Binding JumpToLatestCommand}"
      AutomationProperties.Name="Jump to latest log lines"
    />
  </Grid>
</UserControl>
