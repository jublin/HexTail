<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:HexTail.ViewModels"
  xmlns:ic="https://github.com/projektanker/icons.avalonia"
  x:Class="HexTail.Views.SettingsPanel"
  x:DataType="vm:MainWindowViewModel"
  KeyboardNavigation.TabNavigation="Cycle"
  AutomationProperties.Name="Settings"
>
  <UserControl.Styles>
    <Style Selector="TabControl[TabStripPlacement=Left] TabItem">
      <Setter Property="MinWidth" Value="140" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
  </UserControl.Styles>
  <Border
    Classes="settings-modal"
    Width="960"
    Height="640"
    MaxWidth="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=Window}}"
    MaxHeight="{Binding Bounds.Height, RelativeSource={RelativeSource AncestorType=Window}}"
    Margin="24"
  >
    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
        <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button
          x:Name="SettingsCloseButton"
          Name="SettingsCloseButton"
          Grid.Column="1"
          Classes="icon tab-close settings-close"
          Command="{Binding ToggleSettingsCommand}"
          ToolTip.Tip="Close settings"
          AutomationProperties.Name="Close settings"
        >
          <ic:Icon Value="mdi-close" />
        </Button>
      </Grid>
      <TabControl
        Grid.Row="1"
        SelectedIndex="{Binding Settings.SectionIndex, Mode=TwoWay}"
        TabStripPlacement="Left"
      >
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ic:Icon Value="mdi-palette-outline" />
              <TextBlock Text="Appearance" />
            </StackPanel>
          </TabItem.Header>
          <Border Classes="settings-section" Margin="16,0,0,0">
            <Grid Classes="responsive-columns" ColumnDefinitions="*,*" ColumnSpacing="15">
              <StackPanel Spacing="6">
                <TextBlock Text="Density" />
                <ComboBox
                  x:Name="DensityBox"
                  AutomationProperties.Name="Density"
                  HorizontalContentAlignment="Right"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Settings.DensityOptions}"
                  SelectedItem="{Binding Settings.Density, Mode=TwoWay}"
                />
                <TextBlock Text="Log font size" />
                <ComboBox
                  x:Name="FontSizeBox"
                  AutomationProperties.Name="Log font size"
                  HorizontalContentAlignment="Right"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Settings.FontSizeOptions}"
                  SelectedItem="{Binding Settings.FontSize, Mode=TwoWay}"
                />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="Theme" />
                <ComboBox
                  x:Name="ThemeBox"
                  AutomationProperties.Name="Theme"
                  HorizontalContentAlignment="Right"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Settings.ThemeOptions}"
                  SelectedItem="{Binding Settings.SelectedTheme, Mode=TwoWay}"
                  DisplayMemberBinding="{Binding DisplayName}"
                />
              </StackPanel>
            </Grid>
          </Border>
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ic:Icon Value="mdi-tune-variant" />
              <TextBlock Text="Limits" />
            </StackPanel>
          </TabItem.Header>
          <Border Classes="settings-section" Margin="16,0,0,0">
            <StackPanel Spacing="6" MaxWidth="420" HorizontalAlignment="Left">
              <TextBlock Text="Maximum lines per source" />
              <NumericUpDown
                x:Name="MaxLinesBox"
                Minimum="1000"
                Maximum="1000000"
                Increment="1000"
                FormatString="N0"
                Value="{Binding Settings.MaxLinesValue, Mode=TwoWay}"
                AutomationProperties.Name="Maximum lines per source"
              />
              <TextBlock Text="Applies to sources opened after the change." Classes="hint" />
              <TextBlock Text="Context lines before the selected row" Margin="0,8,0,0" />
              <NumericUpDown
                x:Name="ContextAboveBox"
                Minimum="0"
                Maximum="50"
                Value="{Binding Settings.ContextAboveValue, Mode=TwoWay}"
                AutomationProperties.Name="Context lines before"
              />
              <TextBlock Text="Context lines after the selected row" />
              <NumericUpDown
                x:Name="ContextBelowBox"
                Minimum="0"
                Maximum="50"
                Value="{Binding Settings.ContextBelowValue, Mode=TwoWay}"
                AutomationProperties.Name="Context lines after"
              />
              <TextBlock Text="Initial Elastic fetch (newest lines)" Margin="0,8,0,0" />
              <NumericUpDown
                x:Name="ElasticInitialLinesBox"
                Minimum="100"
                Maximum="100000"
                Increment="1000"
                FormatString="N0"
                Value="{Binding Settings.ElasticInitialLinesValue, Mode=TwoWay}"
                AutomationProperties.Name="Initial Elastic fetch"
              />
              <TextBlock Text="Applies to Elastic views opened after the change." Classes="hint" />
            </StackPanel>
          </Border>
        </TabItem>
      </TabControl>
      <TextBlock
        x:Name="SettingsSaveError"
        AutomationProperties.LiveSetting="Assertive"
        Grid.Row="2"
        Classes="error"
        Margin="0,12,0,0"
        TextWrapping="Wrap"
        IsVisible="{Binding Settings.HasSaveError}"
        Text="{Binding Settings.SaveError}"
      />
      <TextBlock
        Grid.Row="3"
        Margin="0,8,0,0"
        Foreground="{DynamicResource MutedBrush}"
        IsVisible="{Binding Settings.IsSaving}"
        Text="Saving…"
      />
    </Grid>
  </Border>
</UserControl>
