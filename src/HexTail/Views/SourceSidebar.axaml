<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:HexTail.ViewModels"
  xmlns:ic="https://github.com/projektanker/icons.avalonia"
  xmlns:i="using:Avalonia.Xaml.Interactivity"
  xmlns:behaviors="using:HexTail.Behaviors"
  x:Class="HexTail.Views.SourceSidebar"
  x:DataType="vm:MainWindowViewModel"
  AutomationProperties.Name="Sources"
>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="8" Spacing="2">
      <StackPanel x:Name="StreamsSection" Spacing="2">
        <Grid ColumnDefinitions="*,Auto" Margin="4,4,0,2">
          <TextBlock Text="STREAMS" Classes="sidebar-heading" />
          <Button
            x:Name="SidebarNewStreamButton"
            Grid.Column="1"
            Classes="icon tab-close"
            Width="24"
            Height="24"
            FontSize="16"
            Command="{Binding NewStreamCommand}"
            ToolTip.Tip="New stream"
            AutomationProperties.Name="New stream"
          >
            <ic:Icon Value="mdi-plus" />
          </Button>
        </Grid>
        <TextBlock
          x:Name="NoStreamsHint"
          Text="No streams. Merge sources by timestamp."
          Classes="hint"
          TextWrapping="Wrap"
          Margin="6,2"
          IsVisible="{Binding !HasStreams}"
        />
        <ItemsControl x:Name="StreamList" ItemsSource="{Binding StreamRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StreamRowViewModel">
              <Border
                Classes="source-row"
                Classes.selected="{Binding IsSelected}"
                ToolTip.Tip="{Binding ToolTip}"
              >
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="2">
                  <Button
                    Classes="source-select"
                    Command="{Binding $parent[UserControl].DataContext.OpenStreamCommand}"
                    CommandParameter="{Binding Id}"
                    AutomationProperties.Name="{Binding Name, StringFormat='Open {0}'}"
                  >
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <ItemsControl ItemsSource="{Binding Dots}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Ellipse Width="8" Height="8" Fill="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock
                        Text="{Binding Name}"
                        Classes.muted="{Binding !IsOpen}"
                        TextTrimming="CharacterEllipsis"
                      />
                    </StackPanel>
                  </Button>
                  <Button
                    Grid.Column="1"
                    Classes="icon tab-close"
                    Width="22"
                    Height="22"
                    FontSize="14"
                    Command="{Binding $parent[UserControl].DataContext.EditStreamCommand}"
                    CommandParameter="{Binding Id}"
                    ToolTip.Tip="{Binding Name, StringFormat='Edit {0}'}"
                    AutomationProperties.Name="{Binding Name, StringFormat='Edit {0}'}"
                  >
                    <ic:Icon Value="mdi-pencil-outline" />
                  </Button>
                  <Button
                    Grid.Column="2"
                    Classes="icon tab-close"
                    Width="22"
                    Height="22"
                    FontSize="14"
                    IsVisible="{Binding IsOpen}"
                    Command="{Binding $parent[UserControl].DataContext.CloseStreamCommand}"
                    CommandParameter="{Binding Tab}"
                    ToolTip.Tip="{Binding Name, StringFormat='Close {0}'}"
                    AutomationProperties.Name="{Binding Name, StringFormat='Close {0}'}"
                  >
                    <ic:Icon Value="mdi-close" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel x:Name="StreamEditorPanel" IsVisible="{Binding IsStreamEditorOpen}">
          <Border
            DataContext="{Binding StreamEditor}"
            x:DataType="vm:StreamEditorViewModel"
            Classes="stream-editor"
            Background="{DynamicResource RaisedAltBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8"
            Margin="0,4"
          >
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
              <TextBox
                x:Name="StreamNameBox"
                Text="{Binding Name, Mode=TwoWay}"
                PlaceholderText="Stream name"
                AutomationProperties.Name="Stream name"
              />
              <TextBlock Text="Sources to merge" Classes="sidebar-heading" />
              <TextBlock
                Text="Open at least two sources to make a stream."
                Classes="hint"
                TextWrapping="Wrap"
                IsVisible="{Binding NeedsMoreSources}"
              />
              <ItemsControl x:Name="StreamChoiceList" ItemsSource="{Binding Choices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StreamMemberChoice">
                    <CheckBox
                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                      ToolTip.Tip="{Binding ToolTip}"
                      AutomationProperties.Name="{Binding Label}"
                    >
                      <TextBlock
                        Text="{Binding Label}"
                        Classes.muted="{Binding IsMissing}"
                        TextTrimming="CharacterEllipsis"
                      />
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock
                x:Name="StreamEditorError"
                Text="{Binding Error}"
                IsVisible="{Binding HasError}"
                Classes="error"
                TextWrapping="Wrap"
                FontSize="12"
              />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button
                  x:Name="StreamSaveButton"
                  Content="Save"
                  Classes="primary"
                  Command="{Binding SaveCommand}"
                  AutomationProperties.Name="Save stream"
                />
                <Button
                  x:Name="StreamCancelButton"
                  Content="Cancel"
                  Command="{Binding CancelCommand}"
                  AutomationProperties.Name="Cancel stream editor"
                />
                <Button
                  x:Name="StreamDeleteButton"
                  Content="Delete"
                  IsVisible="{Binding IsEditMode}"
                  Command="{Binding DeleteCommand}"
                  AutomationProperties.Name="Delete stream"
                />
              </StackPanel>
              <StackPanel
                x:Name="StreamDeleteConfirm"
                Spacing="6"
                IsVisible="{Binding IsConfirmingDelete}"
              >
                <TextBlock
                  Text="Delete this stream? Its member sources stay open."
                  Classes="error"
                  TextWrapping="Wrap"
                  FontSize="12"
                />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button
                    x:Name="StreamDeleteConfirmButton"
                    Content="Confirm"
                    Command="{Binding ConfirmDeleteCommand}"
                    AutomationProperties.Name="Confirm delete stream"
                  />
                  <Button
                    x:Name="StreamDeleteKeepButton"
                    Content="Keep"
                    Command="{Binding CancelDeleteCommand}"
                    AutomationProperties.Name="Keep stream"
                  />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>

      <Grid ColumnDefinitions="*,Auto" Margin="4,12,0,2">
        <TextBlock Text="FILES" Classes="sidebar-heading" />
        <Button
          x:Name="SidebarOpenFileButton"
          Grid.Column="1"
          Classes="icon tab-close"
          Width="24"
          Height="24"
          FontSize="16"
          Command="{Binding OpenCommand}"
          ToolTip.Tip="Open log files (Ctrl+O)"
          AutomationProperties.Name="Open log files from sidebar"
        >
          <ic:Icon Value="mdi-plus" />
        </Button>
      </Grid>
      <TextBlock
        x:Name="NoFilesHint"
        Text="No files open"
        Classes="hint"
        Margin="6,2"
        IsVisible="{Binding !HasFileTabs}"
      />
      <ItemsControl x:Name="FileSourceList" ItemsSource="{Binding FileTabs}">
        <i:Interaction.Behaviors>
          <behaviors:ListReorderBehavior />
        </i:Interaction.Behaviors>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FileTabViewModel">
            <Border
              Classes="source-row"
              Classes.selected="{Binding IsSelected}"
              ToolTip.Tip="{Binding SourceDetails}"
            >
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4">
                <Ellipse
                  Classes="source-status"
                  Classes.connected="{Binding !HasError}"
                  Classes.failed="{Binding HasError}"
                  ToolTip.Tip="{Binding Error}"
                />
                <Button
                  Grid.Column="1"
                  Classes="source-select"
                  Command="{Binding $parent[UserControl].DataContext.SelectFileCommand}"
                  CommandParameter="{Binding}"
                  AutomationProperties.Name="{Binding SourceDetails, StringFormat='Select {0}'}"
                >
                  <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Grid.Column="2" Text="{Binding LineCountText}" Classes="source-count" />
                <Button
                  Grid.Column="3"
                  Classes="icon tab-close"
                  Width="22"
                  Height="22"
                  FontSize="14"
                  Command="{Binding $parent[UserControl].DataContext.CloseFileCommand}"
                  CommandParameter="{Binding}"
                  ToolTip.Tip="{Binding SourceDetails, StringFormat='Close {0}'}"
                  AutomationProperties.Name="{Binding SourceDetails, StringFormat='Close {0}'}"
                >
                  <ic:Icon Value="mdi-close" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid ColumnDefinitions="*,Auto" Margin="4,12,0,2">
        <TextBlock Text="ELASTIC" Classes="sidebar-heading" />
        <Button
          x:Name="SidebarElasticSetupButton"
          Grid.Column="1"
          Classes="icon tab-close"
          Width="24"
          Height="24"
          FontSize="16"
          Command="{Binding SetUpElasticCommand}"
          ToolTip.Tip="Set up Elastic"
          AutomationProperties.Name="Set up Elastic from sidebar"
        >
          <ic:Icon Value="mdi-plus" />
        </Button>
      </Grid>
      <TextBlock
        x:Name="ElasticEmptyHint"
        Text="No Elastic servers"
        Classes="hint"
        Margin="6,2"
        IsVisible="{Binding !HasElasticSources}"
      />
      <ItemsControl x:Name="ElasticGroupList" ItemsSource="{Binding ElasticConnectionGroups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ElasticConnectionGroupViewModel">
            <StackPanel Spacing="1" Margin="0,2">
              <Grid
                ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                ColumnSpacing="4"
                Margin="6,4,4,2"
                ToolTip.Tip="{Binding StatusMessage}"
              >
                <Ellipse
                  Classes="source-status"
                  Classes.connected="{Binding IsConnected}"
                  Classes.failed="{Binding IsFailed}"
                />
                <TextBlock
                  Grid.Column="1"
                  Text="{Binding Name}"
                  FontWeight="SemiBold"
                  TextTrimming="CharacterEllipsis"
                />
                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Classes="source-count" />
                <Button
                  Grid.Column="3"
                  Classes="icon tab-close"
                  Width="22"
                  Height="22"
                  FontSize="14"
                  Command="{Binding AddSourceCommand}"
                  ToolTip.Tip="{Binding Name, StringFormat='Add source to {0}'}"
                  AutomationProperties.Name="{Binding Name, StringFormat='Add source to {0}'}"
                >
                  <ic:Icon Value="mdi-plus" />
                </Button>
                <Button
                  Grid.Column="4"
                  Classes="icon tab-close"
                  Width="22"
                  Height="22"
                  FontSize="14"
                  Command="{Binding EditCommand}"
                  ToolTip.Tip="{Binding Name, StringFormat='Edit {0}'}"
                  AutomationProperties.Name="{Binding Name, StringFormat='Edit {0}'}"
                >
                  <ic:Icon Value="mdi-pencil-outline" />
                </Button>
              </Grid>
              <ItemsControl ItemsSource="{Binding Sources}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ElasticSourceOptionViewModel">
                    <StackPanel>
                      <Border
                        Classes="source-row"
                        Classes.selected="{Binding IsSelected}"
                        Margin="12,0,0,0"
                        ToolTip.Tip="{Binding RowToolTip}"
                      >
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="2">
                          <Button
                            Classes="source-select"
                            Command="{Binding ActivateCommand}"
                            AutomationProperties.Name="{Binding DisplayName, StringFormat='Open {0}'}"
                          >
                            <TextBlock
                              Text="{Binding ShortName}"
                              Classes.muted="{Binding !IsOpen}"
                              TextTrimming="CharacterEllipsis"
                            />
                          </Button>
                          <Button
                            Grid.Column="1"
                            Classes="icon tab-close"
                            Width="22"
                            Height="22"
                            FontSize="14"
                            Command="{Binding EditCommand}"
                            ToolTip.Tip="{Binding DisplayName, StringFormat='Edit {0}'}"
                            AutomationProperties.Name="{Binding DisplayName, StringFormat='Edit {0}'}"
                          >
                            <ic:Icon Value="mdi-pencil-outline" />
                          </Button>
                          <Button
                            Grid.Column="2"
                            Classes="icon tab-close"
                            Width="22"
                            Height="22"
                            FontSize="14"
                            IsVisible="{Binding IsOpen}"
                            Command="{Binding CloseCommand}"
                            ToolTip.Tip="{Binding DisplayName, StringFormat='Close {0}'}"
                            AutomationProperties.Name="{Binding DisplayName, StringFormat='Close {0}'}"
                          >
                            <ic:Icon Value="mdi-close" />
                          </Button>
                        </Grid>
                      </Border>
                      <TextBlock
                        Text="{Binding OpenError}"
                        IsVisible="{Binding HasOpenError}"
                        Classes="error"
                        TextWrapping="Wrap"
                        FontSize="12"
                        Margin="16,0,0,4"
                      />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="SAVED FILTERS" Classes="sidebar-heading" Margin="4,12,0,2" />
      <TextBlock
        x:Name="SavedFiltersEmptyHint"
        Text="No saved filters"
        Classes="hint"
        Margin="6,2"
        IsVisible="{Binding !HasSavedFilters}"
      />
      <ItemsControl x:Name="SavedFilterList" ItemsSource="{Binding SavedFilters}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SavedFilterViewModel">
            <Border Classes="source-row" ToolTip.Tip="{Binding ApplyToolTip}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <Button
                  Classes="source-select"
                  Command="{Binding ApplyCommand}"
                  AutomationProperties.Name="{Binding Name, StringFormat='Apply filter {0}'}"
                >
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Summary}" Classes="hint" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>
                <Button
                  Grid.Column="1"
                  Classes="icon tab-close"
                  Width="22"
                  Height="22"
                  FontSize="14"
                  Command="{Binding DeleteCommand}"
                  ToolTip.Tip="{Binding Name, StringFormat='Delete saved filter {0}'}"
                  AutomationProperties.Name="{Binding Name, StringFormat='Delete saved filter {0}'}"
                >
                  <ic:Icon Value="mdi-close" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
