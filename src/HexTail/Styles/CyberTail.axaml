<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <Styles.Resources>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#090D12" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#0C1219" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#101722" />
    <SolidColorBrush x:Key="RaisedAltBrush" Color="#151F2D" />
    <SolidColorBrush x:Key="ToolbarBrush" Color="#0D141E" />
    <SolidColorBrush x:Key="BorderBrush" Color="#263449" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#354761" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6EDF7" />
    <SolidColorBrush x:Key="MutedBrush" Color="#91A0B5" />
    <SolidColorBrush x:Key="FaintTextBrush" Color="#65758D" />
    <SolidColorBrush x:Key="AccentBrush" Color="#28D7FE" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#4028D7FE" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="#157B94" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#7AEAFF" />
    <SolidColorBrush x:Key="SelectedTabBrush" Color="#28D7FE" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#39E58C" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF667A" />
    <SolidColorBrush x:Key="WarnBrush" Color="#F5B942" />
    <SolidColorBrush x:Key="ErrorRowBrush" Color="#26FF667A" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#99000000" />
    <x:Double x:Key="ControlHeight">34</x:Double>
  </Styles.Resources>
  <Style Selector="Border.palette">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Border.command-bar">
    <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
  </Style>
  <Style Selector="Border.settings-sheet">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Border.settings-modal">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="Border.settings-section">
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="18" />
  </Style>
  <Style Selector="Expander.elastic-card">
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Border.elastic-section">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10" />
  </Style>
  <Style Selector="TextBlock.section-label">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
  </Style>
  <Style Selector="TextBox.elastic-title">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.elastic-status">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Border.elastic-views">
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Expander.elastic-view-card">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10" />
  </Style>
  <Style Selector="TextBlock.elastic-form-label">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="CheckBox.elastic-field-chip">
    <Setter Property="Margin" Value="0,0,8,6" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Background" Value="{DynamicResource RaisedAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SurfaceBrush}" />
  </Style>
  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}" />
  </Style>
  <Style Selector="Button.range-pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="20" />
  </Style>
  <Style Selector="Button.icon.destructive">
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
  </Style>
  <Style Selector="Button.search-close">
    <Setter Property="Foreground" Value="{DynamicResource AccentMutedBrush}" />
  </Style>
  <Style Selector="Button.tab-close">
    <Setter Property="CornerRadius" Value="50" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TabControl.log-tabs TabItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="TextBlock.status-live">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
  </Style>
  <Style Selector="ListBox.log-list">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Border.source-row">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="6,0,2,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.source-row.selected">
    <Setter Property="Background" Value="{DynamicResource RaisedAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SelectedTabBrush}" />
  </Style>
  <Style Selector="Button.source-select">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,5" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="TextBlock.sidebar-heading">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.source-count">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,monospace" />
    <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="4,0" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Ellipse.source-status">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Ellipse.source-status.connected">
    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="Ellipse.source-status.failed">
    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
  </Style>
  <Style Selector="TextBlock.status">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.setup-title">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.setup-step">
    <Setter Property="Padding" Value="8,8" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Button.setup-step:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.setup-step.current">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.setup-step.done">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Border.filter-chip">
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="Padding" Value="10,2,2,2" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="Background" Value="{DynamicResource RaisedAltBrush}" />
  </Style>
  <Style Selector="Border.filter-chip.zero-count">
    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
  </Style>
  <Style Selector="TextBlock.chip-count">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,monospace" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.filter-chip.zero-count TextBlock.chip-count">
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
  </Style>
  <Style Selector="TextBlock.preview-row">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,monospace" />
  </Style>
  <Style Selector="Border.step-badge">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
  </Style>
  <Style Selector="Button.setup-step.current Border.step-badge">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.setup-step.current Border.step-badge TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SurfaceBrush}" />
  </Style>
  <Style Selector="Button.setup-step.done Border.step-badge">
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="Button.setup-step.done Border.step-badge TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>
<Style Selector="Rectangle.chip-outline">
  <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
  <Setter Property="StrokeThickness" Value="1" />
  <Setter Property="Fill" Value="{DynamicResource RaisedAltBrush}" />
</Style>
<Style Selector="Rectangle.chip-outline.global">
  <Setter Property="StrokeDashArray" Value="3,2" />
</Style>
<Style Selector="Border.level-segment">
  <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
  <Setter Property="BorderThickness" Value="1" />
  <Setter Property="CornerRadius" Value="4" />
  <Setter Property="ClipToBounds" Value="True" />
</Style>
<Style Selector="Border.level-segment.filtered">
  <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
</Style>
<Style Selector="Border.level-segment ToggleButton">
  <Setter Property="MinWidth" Value="24" />
  <Setter Property="MinHeight" Value="0" />
  <Setter Property="Padding" Value="4,0" />
  <Setter Property="BorderThickness" Value="0" />
  <Setter Property="CornerRadius" Value="0" />
  <Setter Property="VerticalAlignment" Value="Stretch" />
</Style>
<Style Selector="Border.level-segment ToggleButton:checked">
  <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
</Style>
<Style Selector="Border.level-segment ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
  <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
</Style>
<Style Selector="ToggleButton.source-chip">
  <Setter Property="MinHeight" Value="0" />
  <Setter Property="Padding" Value="8,2" />
  <Setter Property="CornerRadius" Value="10" />
  <Setter Property="BorderThickness" Value="1" />
  <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
</Style>
<Style Selector="ToggleButton.source-chip:checked">
  <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
</Style>
<Style Selector="ToggleButton.source-chip:checked /template/ ContentPresenter#PART_ContentPresenter">
  <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
</Style>
<Style Selector="ToggleButton.source-chip:unchecked">
  <Setter Property="Opacity" Value="0.6" />
</Style>
<Style Selector="Grid.rule-chip.disabled">
  <Setter Property="Opacity" Value="0.5" />
</Style>
<Style Selector="Grid.rule-chip.disabled TextBlock.chip-text">
  <Setter Property="TextDecorations" Value="Strikethrough" />
</Style>
<Style Selector="Button.chip-body">
  <Setter Property="Background" Value="Transparent" />
  <Setter Property="BorderThickness" Value="0" />
  <Setter Property="Padding" Value="2,0" />
  <Setter Property="MinHeight" Value="0" />
</Style>
<Style Selector="Button.swatch">
  <Setter Property="Width" Value="16" />
  <Setter Property="Height" Value="16" />
  <Setter Property="MinWidth" Value="0" />
  <Setter Property="MinHeight" Value="0" />
  <Setter Property="Padding" Value="0" />
  <Setter Property="CornerRadius" Value="8" />
</Style>
<Style Selector="Button.swatch.selected">
  <Setter Property="BorderThickness" Value="2" />
  <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" />
</Style>
<!-- Column-mode row cells -->
<Style Selector=":is(TextBlock).cell.dimmed">
  <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}" />
</Style>
<Style Selector=":is(TextBlock).cell.trc">
  <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}" />
</Style>
<Style Selector=":is(TextBlock).cell.dbg">
  <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
</Style>
<Style Selector=":is(TextBlock).cell.inf">
  <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
</Style>
<Style Selector=":is(TextBlock).cell.wrn">
  <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
</Style>
<Style Selector=":is(TextBlock).cell.err">
  <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
  <Setter Property="FontWeight" Value="SemiBold" />
</Style>
</Styles>
