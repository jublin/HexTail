<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:HexTail.ViewModels"
  xmlns:views="using:HexTail.Views"
  xmlns:i="https://github.com/projektanker/icons.avalonia"
  xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
  x:Class="HexTail.MainWindow"
  x:DataType="vm:MainWindowViewModel"
  Title="Hex Tail"
  Width="1920"
  Height="1080"
  MinWidth="720"
  MinHeight="720"
  Background="{DynamicResource SurfaceBrush}"
  DragDrop.AllowDrop="True"
>
  <dialogHost:DialogHost
    x:Name="SettingsDialogHost"
    IsOpen="{Binding SettingsOpen, Mode=TwoWay}"
    CloseOnClickAway="True"
  >
    <dialogHost:DialogHost.DialogContent>
      <views:SettingsPanel />
    </dialogHost:DialogHost.DialogContent>

    <Grid
      RowDefinitions="Auto,Auto,Auto,*"
      Background="{DynamicResource SurfaceBrush}"
      HorizontalAlignment="Stretch"
    >
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" HorizontalAlignment="Stretch">
        <CommandBar
          Grid.Column="0"
          HorizontalAlignment="Left"
          HasMirrorTransform="True"
          VerticalAlignment="Top"
          FlowDirection="LeftToRight"
          DefaultLabelPosition="Collapsed"
          BorderBrush="{DynamicResource RaisedBrush}"
        >
          <CommandBar.PrimaryCommands>
            <CommandBarButton
              x:Name="SettingsButton"
              Foreground="{DynamicResource TextBrush}"
              Command="{Binding ToggleSettingsCommand}"
              Label="Settings"
              ToolTip.Tip="Open settings"
              AutomationProperties.Name="Open settings"
            >
              <CommandBarButton.Icon>
                <i:Icon
                  Foreground="{DynamicResource AccentBrush}"
                  FontSize="22"
                  Value="mdi-cogs"
                  Background="{DynamicResource SurfaceBrush}"
                />
              </CommandBarButton.Icon>
            </CommandBarButton>
            <CommandBarButton
              x:Name="ElasticSourcesButton"
              IsVisible="{Binding HasElasticSources}"
              Label="Elastic sources"
              ToolTip.Tip="Select Elastic sources"
              AutomationProperties.Name="Elastic sources"
            >
              <CommandBarButton.Icon>
                <i:Icon Value="{Binding ElasticSourceIcon}" FontSize="22" />
              </CommandBarButton.Icon>
              <CommandBarButton.Flyout>
                <Flyout>
                  <ItemsControl ItemsSource="{Binding ElasticSources}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ElasticSourceOptionViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <i:Icon Value="{Binding StatusGlyph}" />
                          <CheckBox
                            Content="{Binding DisplayName}"
                            ToolTip.Tip="{Binding ToolTip}"
                            AutomationProperties.Name="{Binding ToolTip}"
                            IsChecked="{Binding IsOpen, Mode=TwoWay}"
                          />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Flyout>
              </CommandBarButton.Flyout>
            </CommandBarButton>
            <CommandBarSeparator />
            <CommandBarButton
              Command="{Binding SaveCommand}"
              Foreground="{DynamicResource TextBrush}"
              Label="Save Session"
              ToolTip.Tip="Save session"
              AutomationProperties.Name="Save session"
            >
              <CommandBarButton.Icon>
                <i:Icon
                  Foreground="{DynamicResource AccentBrush}"
                  Value="mdi-content-save"
                  FontSize="22"
                  Background="{DynamicResource SurfaceBrush}"
                />
              </CommandBarButton.Icon>
            </CommandBarButton>
            <CommandBarButton
              Label="Open"
              Command="{Binding OpenCommand}"
              Foreground="{DynamicResource TextBrush}"
              ToolTip.Tip="Open log files"
              AutomationProperties.Name="Open log files"
            >
              <CommandBarButton.Icon>
                <i:Icon
                  Foreground="{DynamicResource AccentBrush}"
                  Value="mdi-folder-open"
                  FontSize="22"
                  Background="{DynamicResource SurfaceBrush}"
                />
              </CommandBarButton.Icon>
            </CommandBarButton>
          </CommandBar.PrimaryCommands>
        </CommandBar>

        <DockPanel Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,5,0">
          <ToggleSwitch
            OnContent="Following"
            OffContent="Not Following"
            FontSize="12"
            DockPanel.Dock="Right"
            DataContext="{Binding SelectedFile}"
            Padding="{Binding Workspace.Settings.SecondaryPadding}"
            MinHeight="{Binding Workspace.Settings.SecondaryControlHeight}"
            IsChecked="{Binding SelectedView.IsFollowing, Mode=TwoWay}"
          />
          <ToggleSwitch
            OnContent="Inline Shown"
            OffContent="No Inline"
            FontSize="12"
            DockPanel.Dock="Right"
            DataContext="{Binding SelectedFile}"
            Padding="{Binding Workspace.Settings.SecondaryPadding}"
            MinHeight="{Binding Workspace.Settings.SecondaryControlHeight}"
            IsChecked="{Binding ShowContext, Mode=TwoWay}"
          />
        </DockPanel>
        <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,0,5,0">
          <views:SearchBar DataContext="{Binding }" />

          <StackPanel Grid.Column="1" x:Name="ElasticTimeRangePanel" VerticalAlignment="Center"
                      Margin="6,0,0,0" IsVisible="{Binding IsElasticSelected}">
            <Button x:Name="ElasticTimeRangeButton" Content="Time range…"
                    AutomationProperties.Name="Elastic log time range">
              <Button.Flyout>
                <Flyout>
                  <StackPanel Spacing="8" Width="390">
                    <TextBlock Text="Log time range (UTC)" FontWeight="SemiBold" />
                    <TextBlock Text="From (inclusive)" />
                    <StackPanel Spacing="4">
                      <DatePicker x:Name="ElasticFromDatePicker" SelectedDate="{Binding ElasticFromDate, Mode=TwoWay}"
                                  MonthFormat="MM" DayFormat="dd" YearFormat="yyyy"
                                  HorizontalAlignment="Stretch" AutomationProperties.Name="From date UTC" />
                      <TimePicker x:Name="ElasticFromTimePicker" HorizontalAlignment="Stretch"
                                  SelectedTime="{Binding ElasticFromTime, Mode=TwoWay}"
                                  ClockIdentifier="24HourClock" UseSeconds="True"
                                  AutomationProperties.Name="From time UTC" />
                    </StackPanel>
                    <CheckBox x:Name="ElasticToNowCheckBox" Content="To now (live logs)" IsChecked="{Binding ElasticToNow, Mode=TwoWay}" />
                    <TextBlock Text="To (inclusive)" />
                    <StackPanel Spacing="4" IsEnabled="{Binding !ElasticToNow}">
                      <DatePicker x:Name="ElasticToDatePicker" SelectedDate="{Binding ElasticToDate, Mode=TwoWay}"
                                  MonthFormat="MM" DayFormat="dd" YearFormat="yyyy"
                                  HorizontalAlignment="Stretch" AutomationProperties.Name="To date UTC" />
                      <TimePicker x:Name="ElasticToTimePicker" HorizontalAlignment="Stretch"
                                  SelectedTime="{Binding ElasticToTime, Mode=TwoWay}"
                                  ClockIdentifier="24HourClock" UseSeconds="True"
                                  AutomationProperties.Name="To time UTC" />
                    </StackPanel>
                    <TextBlock Text="{Binding FileError}" IsVisible="{Binding HasFileError}"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                    <Button x:Name="ApplyElasticTimeRangeButton" Content="Apply"
                            Command="{Binding ApplyElasticTimeRangeCommand}" Classes="primary" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>

        </Grid>
      </Grid>
      <views:FileStrip Grid.Column="0" Grid.Row="1" />
      <views:WorkspaceError Grid.Column="0" Grid.Row="2" />
      <views:LogWorkspace Grid.Column="0" Grid.Row="3" />
    </Grid>
  </dialogHost:DialogHost>
</Window>
