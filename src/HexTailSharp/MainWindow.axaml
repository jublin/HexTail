<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HexTailSharp.MainWindow"
        Title="HexTail"
        Width="1280"
        Height="800"
        MinWidth="720"
        MinHeight="480"
        Background="{DynamicResource SurfaceBrush}">
  <Grid RowDefinitions="Auto,*"
        Background="{DynamicResource SurfaceBrush}"
        DragDrop.AllowDrop="True"
        DragDrop.DragOver="OnDragOver"
        DragDrop.Drop="OnDrop">
    <Border Grid.Row="0"
            Background="{DynamicResource ToolbarBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="SettingsButton"
                Content="☰"
                ToolTip.Tip="Open settings"
                Click="ToggleSettings" />
        <TextBlock Text="HexTail"
                   VerticalAlignment="Center"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}"
                   Margin="4,0,12,0" />
        <Button x:Name="OpenButton"
                Content="Pick and tail log files"
                Click="PickFiles" />
        <TextBlock x:Name="FileCountText"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource MutedTextBrush}"
                   FontSize="12" />
      </StackPanel>
    </Border>

    <SplitView Grid.Row="1"
               x:Name="SettingsSplitView"
               PanePlacement="Right"
               DisplayMode="Overlay"
               OpenPaneLength="320"
               IsPaneOpen="False">
      <SplitView.Pane>
        <Border Background="{DynamicResource ToolbarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Padding="16">
          <Grid RowDefinitions="Auto,Auto,*">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Settings"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextBrush}"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Content="×"
                      ToolTip.Tip="Close settings"
                      Click="ToggleSettings" />
            </Grid>
            <ListBox x:Name="SettingsSections"
                     Grid.Row="1"
                     Margin="0,16,0,12"
                     SelectionChanged="SettingsSectionChanged">
              <ListBoxItem Content="Global labels" Tag="labels" />
              <ListBoxItem Content="Global exclusions" Tag="exclusions" />
              <ListBoxItem Content="Theme" Tag="theme" />
              <ListBoxItem Content="UI spacing" Tag="density" />
              <ListBoxItem Content="Log font size" Tag="font-size" />
              <ListBoxItem Content="Menu alignment" Tag="menu-alignment" />
            </ListBox>
            <ScrollViewer Grid.Row="2"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="SettingsEditor" Spacing="10" />
            </ScrollViewer>
          </Grid>
        </Border>
      </SplitView.Pane>

      <SplitView.Content>
        <Grid x:Name="WorkspaceGrid"
              RowDefinitions="Auto,Auto,Auto,*"
              Background="{DynamicResource SurfaceBrush}">
          <ScrollViewer Grid.Row="0"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="FileTabsPanel"
                        Orientation="Horizontal"
                        Spacing="2"
                        Background="{DynamicResource RaisedSurfaceBrush}"
                        MinHeight="42" />
          </ScrollViewer>
          <Border x:Name="FileErrorBorder"
                  Grid.Row="1"
                  Background="{DynamicResource ErrorBackgroundBrush}"
                  BorderBrush="{DynamicResource ErrorBorderBrush}"
                  BorderThickness="0,0,0,1"
                  Padding="12,7"
                  IsVisible="False">
            <TextBlock x:Name="FileErrorText"
                       Foreground="{DynamicResource ErrorTextBrush}"
                       TextWrapping="Wrap" />
          </Border>
          <Border x:Name="EmptyState"
                  Grid.Row="3"
                  Background="{DynamicResource SurfaceBrush}">
            <TextBlock Text="Open a file to start tailing."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" />
          </Border>
          <Grid x:Name="FileWorkspace"
                Grid.Row="2"
                Grid.RowSpan="2"
                RowDefinitions="Auto,Auto,*"
                IsVisible="False">
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="12,8">
              <TextBox x:Name="QueryBox"
                       PlaceholderText="Search this file"
                       MinWidth="220"
                       HorizontalAlignment="Stretch"
                       KeyDown="QueryKeyDown" />
              <ComboBox x:Name="ModeBox"
                        Width="110"
                        PlaceholderText="Match mode" />
              <CheckBox x:Name="CaseSensitiveBox"
                        Content="Case sensitive"
                        VerticalAlignment="Center" />
              <ColorPicker x:Name="SearchColorPicker"
                           Width="46"
                           Height="36"
                           IsAlphaEnabled="False"
                           ToolTip.Tip="Search highlight color" />
              <Button Content="Add search"
                      Click="AddSearch" />
              <Button Content="Save"
                      Click="SaveSession" />
            </StackPanel>
            <Border x:Name="SearchErrorBorder"
                    Grid.Row="1"
                    Background="{DynamicResource ErrorBackgroundBrush}"
                    BorderBrush="{DynamicResource ErrorBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,7"
                    IsVisible="False">
              <TextBlock x:Name="SearchErrorText"
                         Foreground="{DynamicResource ErrorTextBrush}"
                         TextWrapping="Wrap" />
            </Border>
            <Grid Grid.Row="2"
                  RowDefinitions="Auto,*">
              <StackPanel Orientation="Horizontal"
                          Spacing="12"
                          Margin="12,7">
                <CheckBox x:Name="FollowAllBox"
                          Content="Follow All"
                          IsCheckedChanged="FollowAllChanged" />
                <CheckBox x:Name="ShowContextBox"
                          Content="Show inline context"
                          IsCheckedChanged="ShowContextChanged" />
                <TextBlock x:Name="LineCountText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="12" />
              </StackPanel>
              <TabControl x:Name="ViewTabs"
                          Grid.Row="1"
                          SelectionChanged="ViewTabChanged" />
            </Grid>
          </Grid>
        </Grid>
      </SplitView.Content>
    </SplitView>
  </Grid>
</Window>
