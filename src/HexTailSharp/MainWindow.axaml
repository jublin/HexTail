<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:HexTailSharp.ViewModels"
  xmlns:views="using:HexTailSharp.Views"
  xmlns:i="https://github.com/projektanker/icons.avalonia"
  x:Class="HexTailSharp.MainWindow"
  x:DataType="vm:MainWindowViewModel"
  Title="Hex Tail"
  Width="1920"
  Height="1080"
  MinWidth="720"
  KeyDown="MainWindowKeyDown"
  MinHeight="480"
  Background="{DynamicResource SurfaceBrush}"
  DragDrop.AllowDrop="True"
>
  <SplitView
    x:Name="SettingsSplitView"
    PanePlacement="Left"
    OpenPaneLength="580"
    IsPaneOpen="{Binding SettingsOpen, Mode=TwoWay}"
    DisplayMode="Inline"
  >
    <SplitView.Pane>
      <views:SettingsPanel />
    </SplitView.Pane>

    <Grid
      RowDefinitions="Auto,Auto,*"
      Background="{DynamicResource SurfaceBrush}"
      HorizontalAlignment="Stretch"
    >
      <!-- <Border -->
      <!--   Grid.Row="0" -->
      <!--   Classes="command-bar" -->
      <!--   HorizontalAlignment="Stretch" -->
      <!--   VerticalAlignment="Top" -->
      <!--   BorderBrush="{DynamicResource BorderBrush}" -->
      <!--   BorderThickness="0,0,0,1" -->
      <!-- > -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
        <CommandBar
          Grid.Column="0"
          HorizontalAlignment="Left"
          HasMirrorTransform="True"
          VerticalAlignment="Top"
          FlowDirection="LeftToRight"
          DefaultLabelPosition="Collapsed"
          BorderBrush="{DynamicResource RaisedBrush}"
        >
          <CommandBar.PrimaryCommands>
            <CommandBarButton
              x:Name="SettingsButton"
              Foreground="{DynamicResource TextBrush}"
              Command="{Binding ToggleSettingsCommand}"
              Label="Settings"
              ToolTip.Tip="Open settings"
              AutomationProperties.Name="Open settings"
            >
              <CommandBarButton.Icon>
                <i:Icon
                  Foreground="{DynamicResource TextBrush}"
                  Value="mdi-menu"
                  Background="{DynamicResource SurfaceBrush}"
                />
              </CommandBarButton.Icon>
            </CommandBarButton>
            <CommandBarSeparator />
            <CommandBarButton
              Command="{Binding SaveCommand}"
              Foreground="{DynamicResource TextBrush}"
              Label="Save Session"
              ToolTip.Tip="Save session"
              AutomationProperties.Name="Save session"
            >
              <CommandBarButton.Icon>
                <i:Icon
                  Foreground="{DynamicResource TextBrush}"
                  Value="mdi-content-save"
                  Background="{DynamicResource SurfaceBrush}"
                />
              </CommandBarButton.Icon>
            </CommandBarButton>
            <CommandBarButton
              Label="Open"
              Command="{Binding OpenCommand}"
              Foreground="{DynamicResource TextBrush}"
              ToolTip.Tip="Open log files"
              AutomationProperties.Name="Open log files"
            >
              <CommandBarButton.Icon>
                i:Icon Foreground="{DynamicResource TextBrush}" Value="mdi-folder-open" Background="{DynamicResource SurfaceBrush}" />
              </CommandBarButton.Icon>
            </CommandBarButton>
          </CommandBar.PrimaryCommands>
        </CommandBar>
        <views:WorkspaceError Grid.Column="0" IsVisible="False" />
      </Grid>
      <!-- </Border> -->
      <views:FileStrip Grid.Row="1" />
      <views:LogWorkspace Grid.Row="2" />
    </Grid>
  </SplitView>
</Window>
