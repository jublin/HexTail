<atom:Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:atom="https://atomui.net"
  xmlns:vm="using:HexTailSharp.ViewModels"
  xmlns:views="using:HexTailSharp.Views"
  x:Class="HexTailSharp.MainWindow"
  x:DataType="vm:MainWindowViewModel"
  Title="HexTail"
  Width="1280"
  Height="800"
  MinWidth="720"
  MinHeight="480"
  Background="{DynamicResource SurfaceBrush}"
>
  <Grid
    Background="{DynamicResource SurfaceBrush}"
    RowDefinitions="Auto,*"
    DragDrop.AllowDrop="True"
    DragDrop.DragOver="OnDragOver"
    DragDrop.Drop="OnDrop"
  >
    <Border
      Grid.Row="0"
      Background="{DynamicResource ToolbarBrush}"
      BorderBrush="{DynamicResource BorderBrush}"
      BorderThickness="0,0,0,1"
      Padding="16,10"
    >
      <StackPanel Orientation="Horizontal" Spacing="10">
        <atom:Button
          Content="☰"
          ToolTip.Tip="Open settings"
          Command="{Binding ToggleSettingsCommand}"
        />
        <TextBlock
          Text="HexTail"
          VerticalAlignment="Center"
          FontSize="18"
          FontWeight="Bold"
          Foreground="{DynamicResource TextBrush}"
          Margin="4,0,12,0"
        />
        <atom:Button
          ButtonType="Primary"
          Content="Open log files"
          Command="{Binding OpenCommand}"
        />
        <atom:Button Content="Save session" Command="{Binding SaveCommand}" />
        <TextBlock
          Text="{Binding FileCount, StringFormat='{}{0} file(s)'}"
          VerticalAlignment="Center"
          Foreground="{DynamicResource MutedTextBrush}"
          FontSize="12"
        />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" RowDefinitions="Auto,*">
      <ScrollViewer
        Grid.Row="0"
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Disabled"
      >
        <ItemsControl ItemsSource="{Binding Files}" Background="{DynamicResource RaisedSurfaceBrush}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FileTabViewModel">
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid ColumnDefinitions="*,Auto">
                  <atom:Button
                    Content="{Binding DisplayName}"
                    Command="{Binding SelectCommand}"
                    HorizontalContentAlignment="Left"
                  />
                  <atom:Button
                    Grid.Column="1"
                    Content="×"
                    ToolTip.Tip="Close file"
                    Command="{Binding CloseCommand}"
                  />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Grid Grid.Row="1" Background="{DynamicResource SurfaceBrush}">
        <atom:Empty
          PresetImage="Simple"
          Description="Open a file to start tailing."
          IsVisible="{Binding ShowEmpty}"
        />

        <ContentControl
          IsVisible="{Binding HasFile}"
          Content="{Binding SelectedFile}"
        >
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:FileTabViewModel">
              <Grid RowDefinitions="Auto,Auto,Auto,*" Background="{DynamicResource SurfaceBrush}">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="12,10">
                  <TextBox
                    Text="{Binding Workspace.Query, Mode=TwoWay}"
                    PlaceholderText="Search this file"
                    MinWidth="240"
                    KeyDown="QueryKeyDown"
                  />
                  <ComboBox
                    Width="110"
                    ItemsSource="{Binding Workspace.MatchModes}"
                    SelectedItem="{Binding Workspace.MatchMode, Mode=TwoWay}"
                  />
                  <atom:CheckBox
                    Content="Case sensitive"
                    IsChecked="{Binding Workspace.CaseSensitive, Mode=TwoWay}"
                    VerticalAlignment="Center"
                  />
                  <atom:ColorPicker
                    Value="{Binding Workspace.SearchColor, Mode=TwoWay}"
                    Width="48"
                    IsAlphaEnabled="False"
                    ToolTip.Tip="Search highlight color"
                  />
                  <atom:Button
                    ButtonType="Primary"
                    Content="Add search"
                    Command="{Binding Workspace.AddSearchCommand}"
                  />
                </StackPanel>
                <atom:Alert
                  Grid.Row="1"
                  Type="Error"
                  Message="{Binding Workspace.SearchError}"
                  IsVisible="{Binding Workspace.HasSearchError}"
                  Margin="12,0"
                />
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="12,8">
                  <atom:CheckBox
                    Content="Follow All"
                    IsChecked="{Binding FollowAll, Mode=TwoWay}"
                    VerticalAlignment="Center"
                  />
                  <atom:CheckBox
                    Content="Show inline context"
                    IsChecked="{Binding ShowContext, Mode=TwoWay}"
                    VerticalAlignment="Center"
                  />
                  <TextBlock
                    Text="{Binding Workspace.LineCount, StringFormat='{}{0:N0} lines'}"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource MutedTextBrush}"
                    FontSize="12"
                  />
                  <TextBlock
                    Text="{Binding SearchCount}"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource MutedTextBrush}"
                    FontSize="12"
                  />
                </StackPanel>
                <atom:TabControl
                  Grid.Row="3"
                  ItemsSource="{Binding Views}"
                  SelectedIndex="{Binding SelectedViewIndex, Mode=TwoWay}"
                  ContentPadding="0"
                >
                  <atom:TabControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LogViewViewModel">
                      <TextBlock Text="{Binding Header}" />
                    </DataTemplate>
                  </atom:TabControl.ItemTemplate>
                  <atom:TabControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:LogViewViewModel">
                      <views:LogView />
                    </DataTemplate>
                  </atom:TabControl.ContentTemplate>
                </atom:TabControl>
              </Grid>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Grid>
    </Grid>

    <atom:Drawer
      IsOpen="{Binding SettingsOpen, Mode=TwoWay}"
      Placement="{Binding SettingsPlacement}"
      Title="Settings"
      DialogSize="360"
      ContentPadding="16"
    >
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <atom:TabControl SelectedIndex="{Binding Settings.SectionIndex, Mode=TwoWay}">
          <atom:TabItem Header="Labels">
            <StackPanel Spacing="10">
              <TextBlock
                Text="Highlight case-insensitive text across every log view."
                Foreground="{DynamicResource MutedTextBrush}"
                TextWrapping="Wrap"
              />
              <ItemsControl ItemsSource="{Binding Settings.Labels}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LabelSettingViewModel">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                      <TextBox Text="{Binding Text, Mode=TwoWay}" PlaceholderText="Text to highlight" />
                      <atom:ColorPicker
                        Grid.Column="1"
                        Value="{Binding Color, Mode=TwoWay}"
                        Width="48"
                        IsAlphaEnabled="False"
                      />
                      <atom:Button
                        Grid.Column="2"
                        Content="×"
                        ToolTip.Tip="Remove label"
                        Command="{Binding $parent[ItemsControl].DataContext.Settings.RemoveLabelCommand}"
                        CommandParameter="{Binding}"
                      />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox Text="{Binding Settings.NewLabelText, Mode=TwoWay}" PlaceholderText="Text to highlight" />
                <atom:ColorPicker
                  Grid.Column="1"
                  Value="{Binding Settings.NewLabelColor, Mode=TwoWay}"
                  Width="48"
                  IsAlphaEnabled="False"
                />
                <atom:Button
                  Grid.Column="2"
                  Content="+"
                  ToolTip.Tip="Add label"
                  Command="{Binding Settings.AddLabelCommand}"
                />
              </Grid>
            </StackPanel>
          </atom:TabItem>
          <atom:TabItem Header="Exclusions">
            <StackPanel Spacing="10">
              <TextBlock
                Text="Matching lines remain buffered but stay hidden from log and context views."
                Foreground="{DynamicResource MutedTextBrush}"
                TextWrapping="Wrap"
              />
              <ItemsControl ItemsSource="{Binding Settings.Exclusions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ExclusionSettingViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                      <TextBox Text="{Binding Text, Mode=TwoWay}" PlaceholderText="Text to hide" />
                      <atom:Button
                        Grid.Column="1"
                        Content="×"
                        ToolTip.Tip="Remove exclusion"
                        Command="{Binding $parent[ItemsControl].DataContext.Settings.RemoveExclusionCommand}"
                        CommandParameter="{Binding}"
                      />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding Settings.NewExclusionText, Mode=TwoWay}" PlaceholderText="Text to hide" />
                <atom:Button
                  Grid.Column="1"
                  Content="+"
                  ToolTip.Tip="Add exclusion"
                  Command="{Binding Settings.AddExclusionCommand}"
                />
              </Grid>
            </StackPanel>
          </atom:TabItem>
          <atom:TabItem Header="Appearance">
            <StackPanel Spacing="10">
              <TextBlock Text="Theme" />
              <ComboBox
                ItemsSource="{Binding Settings.ThemeOptions}"
                SelectedItem="{Binding Settings.Theme, Mode=TwoWay}"
              />
              <TextBlock Text="UI spacing" />
              <ComboBox
                ItemsSource="{Binding Settings.DensityOptions}"
                SelectedItem="{Binding Settings.Density, Mode=TwoWay}"
              />
              <TextBlock Text="Log font size" />
              <ComboBox
                ItemsSource="{Binding Settings.FontSizeOptions}"
                SelectedItem="{Binding Settings.FontSize, Mode=TwoWay}"
              />
              <TextBlock Text="Menu alignment" />
              <ComboBox
                ItemsSource="{Binding Settings.MenuAlignmentOptions}"
                SelectedItem="{Binding Settings.MenuAlignment, Mode=TwoWay}"
              />
            </StackPanel>
          </atom:TabItem>
        </atom:TabControl>
      </ScrollViewer>
    </atom:Drawer>
  </Grid>
</atom:Window>
