<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:HexTailSharp.ViewModels"
  xmlns:views="using:HexTailSharp.Views"
  x:Class="HexTailSharp.MainWindow"
  x:DataType="vm:MainWindowViewModel"
  Title="Cyber Tail"
  Width="1280"
  Height="800"
  MinWidth="720"
  MinHeight="480"
  Background="{DynamicResource CyberSurfaceBrush}"
  DragDrop.AllowDrop="True"
>
  <SplitView
    x:Name="SettingsSplitView"
    PanePlacement="Right"
    OpenPaneLength="380"
    IsPaneOpen="{Binding SettingsOpen, Mode=TwoWay}"
    DisplayMode="Inline"
  >
    <SplitView.Pane>
      <views:SettingsPanel />
    </SplitView.Pane>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Background="{DynamicResource CyberSurfaceBrush}">
      <Border Grid.Row="0" Classes="command-bar" BorderBrush="{DynamicResource CyberBorderBrush}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="SettingsButton" Command="{Binding ToggleSettingsCommand}" Content="Settings" ToolTip.Tip="Open settings" />
          <TextBlock Text="Cyber Tail" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource CyberTextBrush}" Margin="4,0,12,0" />
          <Button Command="{Binding SaveCommand}" Content="Save Session" />
          <TextBlock Text="{Binding FileCount, StringFormat='{}{0} file(s)'}" VerticalAlignment="Center" Foreground="{DynamicResource CyberMutedBrush}" />
        </StackPanel>
      </Border>
      <views:FileStrip Grid.Row="1" />
      <views:WorkspaceError Grid.Row="2" />
      <views:SearchBar Grid.Row="3" />
      <views:LogWorkspace Grid.Row="4" />
    </Grid>
  </SplitView>
</Window>
