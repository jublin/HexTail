@page "/"

@using System.Net
@using HexTailSharp.Application
@using HexTailSharp.Domain
@using HexTailSharp.Persistence
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Radzen
@using Radzen.Blazor
@inject AppState State
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>HexTail</PageTitle>

<RadzenStack class="hextail-shell" Gap="0">
    <RadzenStack class="app-toolbar" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap=".5rem">
        <RadzenStack class="brand" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap=".4rem">
            <span class="brand-mark">⌁</span><span>HexTail</span>
        </RadzenStack>
        <RadzenButton Text="Pick and tail log files" Icon="folder_open" ButtonStyle="ButtonStyle.Primary" Click="PickFilesAsync" />
        <span class="toolbar-status">@State.Files.Count file(s)</span>
    </RadzenStack>

    @if (_fileError is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" ShowIcon="true" Text="@_fileError" />
    }

    <RadzenStack class="file-tabs" Orientation="Orientation.Horizontal" Gap="0">
        @foreach (var openFile in State.Files)
        {
            <RadzenStack class="@($"file-tab {(ReferenceEquals(openFile, State.SelectedFile) ? "selected" : string.Empty)}")" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
                <RadzenButton Text="@TabText(openFile)" Title="@openFile.Error" ButtonStyle="ButtonStyle.Light" Click="() => SelectFile(openFile)" />
                <RadzenButton Icon="close" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="() => CloseFileAsync(openFile)" />
            </RadzenStack>
        }
        @if (State.Files.Count == 0)
        {
            <span class="empty-tabs">Open a file to start tailing.</span>
        }
    </RadzenStack>

    @if (State.SelectedFile is { } file)
    {
        <RadzenStack class="workspace" Gap="0">
            <RadzenStack class="search-toolbar" Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.Center" Gap=".65rem">
                <RadzenTextBox @bind-Value="_query" Placeholder="Search this file" Style="flex: 1; min-width: 12rem" />
                <RadzenDropDown @bind-Value="_mode" Data="@MatchModes" TValue="MatchMode" Style="width: 8rem" />
                <label class="toggle"><RadzenCheckBox @bind-Value="_caseSensitive" TValue="bool" /> Case sensitive</label>
                <RadzenColorPicker @bind-Value="_color" />
                <RadzenButton Text="Add search" Icon="search" Click="AddSearchAsync" ButtonStyle="ButtonStyle.Secondary" />
                <RadzenButton Text="Save" Icon="save" Click="SaveAsync" ButtonStyle="ButtonStyle.Light" />
            </RadzenStack>
            @if (_searchError is not null)
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" ShowIcon="true" Text="@_searchError" />
            }

            <RadzenStack class="view-toolbar" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap=".65rem">
                <label class="toggle"><RadzenCheckBox @bind-Value="file.FollowAll" TValue="bool" Change="_ => SaveAsync()" /> Follow All</label>
                <label class="toggle"><RadzenCheckBox @bind-Value="file.ShowContext" TValue="bool" Change="_ => StateHasChanged()" /> Show inline context</label>
                <span class="line-count">@file.Buffer.Count.ToString("N0") lines</span>
            </RadzenStack>

            <RadzenTabs @bind-SelectedIndex="_activeView" Class="view-tabs">
                <Tabs>
                    <RadzenTabsItem Text="All">
                        @RenderView(file, null)
                    </RadzenTabsItem>
                    @foreach (var search in file.Searches)
                    {
                        <RadzenTabsItem Text="@Truncate(search.Query.Query)" IconColor="@search.Color">
                            <RadzenStack class="search-tab-toolbar" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap=".65rem">
                                <label class="toggle"><RadzenCheckBox @bind-Value="file.FollowSearches[file.Searches.IndexOf(search)]" TValue="bool" /> Follow</label>
                                <span>@search.Results.Count.ToString("N0") matches</span>
                            </RadzenStack>
                            @RenderView(file, search)
                        </RadzenTabsItem>
                    }
                </Tabs>
            </RadzenTabs>
        </RadzenStack>
    }
</RadzenStack>

@code {
    private static readonly MatchMode[] MatchModes = [MatchMode.Literal, MatchMode.Regex];
    private readonly CancellationTokenSource _stop = new();
    private DotNetObjectReference<Home>? _browserReference;
    private Task? _pollTask;
    private string _query = string.Empty;
    private MatchMode _mode = MatchMode.Literal;
    private bool _caseSensitive;
    private string _color = "#f59e0b";
    private string? _searchError;
    private string? _fileError;
    private int _activeView;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        await State.RestoreAsync();
        _pollTask = DrainLoopAsync();
    }

    private async Task DrainLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
        try
        {
            while (await timer.WaitForNextTickAsync(_stop.Token))
            {
                State.DrainTailerEvents();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested)
        {
        }
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    private void SelectFile(FileTabState file)
    {
        State.SelectFile(file);
        _activeView = 0;
    }

    private async Task PickFilesAsync()
    {
        _fileError = null;
        _browserReference ??= DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("hexTailFilePicker.pick", _browserReference);
        }
        catch (JSException ex)
        {
            _fileError = ex.Message;
        }
        catch (Exception ex)
        {
            _fileError = $"Could not pick file: {ex.Message}";
        }
    }

    [JSInvokable]
    public void OnBrowserFileLines(string fileId, string fileName, string[] lines)
    {
        if (!State.Files.Any(file => file.Id == fileId))
            State.OpenBrowserFile(fileId, fileName, lines);
        else
            State.AppendBrowserLines(fileId, lines);
    }

    [JSInvokable]
    public void OnBrowserFileTruncated(string fileId) => State.TruncateBrowserFile(fileId);

    private async Task CloseFileAsync(FileTabState file)
    {
        await State.CloseFileAsync(file);
        if (file.IsSnapshot)
            await JS.InvokeVoidAsync("hexTailFilePicker.stop", file.Id);
    }

    private static string TabText(FileTabState file) => file.Error is null ? file.DisplayName : $"! {file.DisplayName}";

    private async Task AddSearchAsync()
    {
        if (State.SelectedFile is not { } file || string.IsNullOrWhiteSpace(_query))
            return;

        try
        {
            State.AddSearch(file, _query, _mode, _caseSensitive, _color);
            await State.SaveAsync();
            _searchError = null;
            _query = string.Empty;
        }
        catch (ArgumentException ex)
        {
            _searchError = ex.Message;
        }
    }

    private async Task SaveAsync() => await State.SaveAsync();

    private RenderFragment RenderView(FileTabState file, Search? search) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "log-view");
        builder.AddAttribute(sequence++, "role", "log");
        builder.OpenComponent<Virtualize<Line>>(sequence++);
        builder.AddAttribute(sequence++, "Items", LinesFor(file, search));
        builder.AddAttribute(sequence++, "ItemSize", 24f);
        builder.AddAttribute(sequence++, "ChildContent", (RenderFragment<Line>)(line => rowBuilder =>
        {
            var rowSequence = 0;
            rowBuilder.OpenElement(rowSequence++, "div");
            rowBuilder.AddAttribute(rowSequence++, "class", "log-row");
            rowBuilder.OpenElement(rowSequence++, "button");
            rowBuilder.AddAttribute(rowSequence++, "class", "log-line");
            rowBuilder.AddAttribute(rowSequence++, "onclick", EventCallback.Factory.Create(this, () => SelectLine(file, line)));
            rowBuilder.AddAttribute(rowSequence++, "ondblclick", EventCallback.Factory.Create(this, () => ToggleExpanded(file, line)));
            rowBuilder.AddContent(rowSequence++, new MarkupString(RenderLine(file, line)));
            rowBuilder.CloseElement();
            if (line.ParsedFields is { Count: > 0 } && file.ExpandedLine == FindLineIndex(file, line))
            {
                rowBuilder.OpenElement(rowSequence++, "div");
                rowBuilder.AddAttribute(rowSequence++, "class", "parsed-fields");
                rowBuilder.AddContent(rowSequence++, string.Join("  ", line.ParsedFields.Select(field => $"{field.Key}={field.Value}")));
                rowBuilder.CloseElement();
            }
            rowBuilder.CloseElement();
        }));
        builder.CloseComponent();
        builder.CloseElement();
        if (file.ShowContext)
        {
            builder.OpenComponent<RadzenSplitter>(sequence++);
            builder.AddAttribute(sequence++, "Orientation", Orientation.Horizontal);
            builder.AddAttribute(sequence++, "Style", "height: 12rem");
            builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(splitterBuilder =>
            {
                var splitSequence = 0;
                splitterBuilder.OpenComponent<RadzenSplitterPane>(splitSequence++);
                splitterBuilder.AddAttribute(splitSequence++, "Size", "100%");
                splitterBuilder.AddAttribute(splitSequence++, "ChildContent", (RenderFragment)(paneBuilder =>
                {
                    var paneSequence = 0;
                    paneBuilder.OpenElement(paneSequence++, "div");
                    paneBuilder.AddAttribute(paneSequence++, "class", "context-empty");
                    paneBuilder.AddContent(paneSequence++, file.SelectedLine is null ? "Select a match to see context." : "Context is shown in the pane below.");
                    paneBuilder.CloseElement();
                }));
                splitterBuilder.CloseComponent();
                splitterBuilder.OpenComponent<RadzenSplitterPane>(splitSequence++);
                splitterBuilder.AddAttribute(splitSequence++, "ChildContent", (RenderFragment)(paneBuilder =>
                {
                    var paneSequence = 0;
                    foreach (var contextLine in file.ContextLines)
                    {
                        paneBuilder.OpenElement(paneSequence++, "div");
                        paneBuilder.AddAttribute(paneSequence++, "class", "context-line");
                        paneBuilder.AddContent(paneSequence++, contextLine.Raw);
                        paneBuilder.CloseElement();
                    }
                }));
                splitterBuilder.CloseComponent();
            }));
            builder.CloseComponent();
        }
    };

    private IEnumerable<Line> LinesFor(FileTabState file, Search? search) =>
        search is null
            ? file.Buffer.Lines
            : search.Results.Where(index => index >= 0 && index < file.Buffer.Count).Select(index => file.Buffer[index]);

    private void SelectLine(FileTabState file, Line line)
    {
        file.SelectedLine = FindLineIndex(file, line);
        StateHasChanged();
    }

    private void ToggleExpanded(FileTabState file, Line line)
    {
        var index = FindLineIndex(file, line);
        file.ExpandedLine = file.ExpandedLine == index ? null : index;
        StateHasChanged();
    }

    private static int FindLineIndex(FileTabState file, Line line)
    {
        for (var i = 0; i < file.Buffer.Count; i++)
        {
            if (ReferenceEquals(file.Buffer[i], line))
                return i;
        }

        return -1;
    }

    private static string RenderLine(FileTabState file, Line line)
    {
        var ranges = file.Searches
            .SelectMany(search => search.GetHighlights(line).Select(range => (range.Start, range.Length, search.Color)))
            .Where(range => range.Start >= 0 && range.Length > 0 && range.Start + range.Length <= line.Raw.Length)
            .OrderBy(range => range.Start)
            .ThenByDescending(range => range.Length)
            .ToList();
        if (ranges.Count == 0)
            return WebUtility.HtmlEncode(line.Raw);

        var output = new System.Text.StringBuilder();
        var cursor = 0;
        foreach (var range in ranges)
        {
            if (range.Start < cursor)
                continue;
            output.Append(WebUtility.HtmlEncode(line.Raw[cursor..range.Start]));
            output.Append("<mark style=\"background:");
            output.Append(WebUtility.HtmlEncode(range.Color));
            output.Append("\">");
            output.Append(WebUtility.HtmlEncode(line.Raw.Substring(range.Start, range.Length)));
            output.Append("</mark>");
            cursor = range.Start + range.Length;
        }

        output.Append(WebUtility.HtmlEncode(line.Raw[cursor..]));
        return output.ToString();
    }

    private static string Truncate(string text) => text.Length > 24 ? $"{text[..21]}..." : text;

    public async ValueTask DisposeAsync()
    {
        State.Changed -= OnStateChanged;
        _stop.Cancel();
        if (_pollTask is not null)
            await _pollTask;
        try
        {
            await JS.InvokeVoidAsync("hexTailFilePicker.stopAll");
        }
        catch (JSException)
        {
        }
        _browserReference?.Dispose();
        _stop.Dispose();
    }
}
