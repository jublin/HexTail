@page "/"

@using System.Net
@using HexTailSharp.Application
@using HexTailSharp.Domain
@using HexTailSharp.Persistence
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Radzen
@using Radzen.Blazor
@inject AppState State
@inject IJSRuntime JS
@inject ThemeService ThemeService
@implements IAsyncDisposable

<PageTitle>HexTail</PageTitle>

<RadzenStack class="@($"hextail-shell density-{State.Settings.Density.ToString().ToLowerInvariant()}")" Gap="0">
    <RadzenStack class="app-toolbar" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap=".5rem">
        <RadzenStack class="brand" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap=".4rem">
            <span class="brand-mark">⌁</span><span>HexTail</span>
        </RadzenStack>
        <RadzenButton Text="Pick and tail log files" Icon="folder_open" ButtonStyle="ButtonStyle.Primary" Click="PickFilesAsync" />
        <span class="toolbar-status">@State.Files.Count file(s)</span>
        <RadzenButton class="settings-button" Icon="settings" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" AriaLabel="Open settings" Click="ToggleSettings" />
    </RadzenStack>

    @if (_settingsOpen)
    {
        <aside class="settings-flyout" aria-label="Settings">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <strong>Settings</strong>
                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" AriaLabel="Close settings" Click="ToggleSettings" />
            </RadzenStack>
            <RadzenPanelMenu class="settings-menu">
                <RadzenPanelMenuItem Text="Global labels" Icon="label" Path="#settings-labels" />
                <RadzenPanelMenuItem Text="Global exclude labels" Icon="visibility_off" Path="#settings-exclusions" />
                <RadzenPanelMenuItem Text="Appearance" Icon="palette" Path="#settings-appearance" />
            </RadzenPanelMenu>

            <section id="settings-labels">
            {
                <RadzenStack Gap=".5rem">
                    <span class="settings-help">Highlight case-insensitive text across every log view.</span>
                    @for (var index = 0; index < State.Settings.GlobalLabels.Count; index++)
                    {
                        var label = State.Settings.GlobalLabels[index];
                        var labelIndex = index;
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap=".35rem">
                            <RadzenTextBox Value="@label.Text" Change="value => UpdateLabelTextAsync(labelIndex, value)" Style="flex: 1" />
                            <RadzenColorPicker Value="@label.Color" Change="value => UpdateLabelColorAsync(labelIndex, value)" />
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" AriaLabel="Remove label" Click="() => RemoveLabelAsync(labelIndex)" />
                        </RadzenStack>
                    }
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap=".35rem">
                        <RadzenTextBox @bind-Value="_newLabel" Placeholder="Text to highlight" Style="flex: 1" />
                        <RadzenColorPicker @bind-Value="_newLabelColor" />
                        <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" AriaLabel="Add label" Click="AddLabelAsync" />
                    </RadzenStack>
                </RadzenStack>
            </section>
            <section id="settings-exclusions">
                <RadzenStack Gap=".5rem">
                    <span class="settings-help">Matching lines stay buffered but are hidden from all log and context views.</span>
                    @for (var index = 0; index < State.Settings.GlobalExcludeLabels.Count; index++)
                    {
                        var label = State.Settings.GlobalExcludeLabels[index];
                        var labelIndex = index;
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap=".35rem">
                            <RadzenTextBox Value="@label" Change="value => UpdateExclusionAsync(labelIndex, value)" Style="flex: 1" />
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" AriaLabel="Remove exclusion" Click="() => RemoveExclusionAsync(labelIndex)" />
                        </RadzenStack>
                    }
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap=".35rem">
                        <RadzenTextBox @bind-Value="_newExclusion" Placeholder="Text to hide" Style="flex: 1" />
                        <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" AriaLabel="Add exclusion" Click="AddExclusionAsync" />
                    </RadzenStack>
                </RadzenStack>
            </section>
            <section id="settings-appearance">
                <RadzenStack Gap=".75rem">
                    <label>Theme <RadzenDropDown TValue="string" Value="@State.Settings.Theme" Data="@Themes" Change="@(async value => await UpdateThemeAsync((string)value))" Style="width: 100%" /></label>
                    <label>UI spacing <RadzenDropDown TValue="UiDensity" Value="@State.Settings.Density" Data="@Densities" Change="@(async value => await UpdateDensityAsync((UiDensity)value))" Style="width: 100%" /></label>
                    <label>Log font size <RadzenDropDown TValue="LogFontSize" Value="@State.Settings.LogFontSize" Data="@FontSizes" Change="@(async value => await UpdateLogFontSizeAsync((LogFontSize)value))" Style="width: 100%" /></label>
                </RadzenStack>
            </section>
        </aside>
    }

    @if (_fileError is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" ShowIcon="true" Text="@_fileError" />
    }

    <RadzenStack class="file-tabs" Orientation="Orientation.Horizontal" Gap="0">
        @foreach (var openFile in State.Files)
        {
            <RadzenStack class="@($"file-tab {(ReferenceEquals(openFile, State.SelectedFile) ? "selected" : string.Empty)}")" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
                <RadzenButton Text="@TabText(openFile)" Title="@openFile.Error" ButtonStyle="ButtonStyle.Light" Click="() => SelectFile(openFile)" />
                <RadzenButton Icon="close" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="() => CloseFileAsync(openFile)" />
            </RadzenStack>
        }
        @if (State.Files.Count == 0)
        {
            <span class="empty-tabs">Open a file to start tailing.</span>
        }
    </RadzenStack>

    @if (State.SelectedFile is { } file)
    {
        <RadzenStack class="workspace" Gap="0">
            <RadzenStack class="search-toolbar" Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.Center" Gap=".65rem">
                <RadzenTextBox @bind-Value="_query" Placeholder="Search this file" Style="flex: 1; min-width: 12rem" />
                <RadzenDropDown @bind-Value="_mode" Data="@MatchModes" TValue="MatchMode" Style="width: 8rem" />
                <label class="toggle"><RadzenCheckBox @bind-Value="_caseSensitive" TValue="bool" /> Case sensitive</label>
                <RadzenColorPicker @bind-Value="_color" />
                <RadzenButton Text="Add search" Icon="search" Click="AddSearchAsync" ButtonStyle="ButtonStyle.Secondary" />
                <RadzenButton Text="Save" Icon="save" Click="SaveAsync" ButtonStyle="ButtonStyle.Light" />
            </RadzenStack>
            @if (_searchError is not null)
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" ShowIcon="true" Text="@_searchError" />
            }

            <RadzenStack class="view-toolbar" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap=".65rem">
                <label class="toggle"><RadzenCheckBox @bind-Value="file.FollowAll" TValue="bool" Change="_ => SaveAsync()" /> Follow All</label>
                <label class="toggle"><RadzenCheckBox @bind-Value="file.ShowContext" TValue="bool" Change="_ => StateHasChanged()" /> Show inline context</label>
                <span class="line-count">@file.Buffer.Count.ToString("N0") lines</span>
            </RadzenStack>

            <RadzenTabs @bind-SelectedIndex="_activeView" Class="view-tabs" RenderMode="TabRenderMode.Client">
                <Tabs>
                    <RadzenTabsItem Text="All">
                        @RenderView(file, null)
                    </RadzenTabsItem>
                    @for (var index = 0; index < file.Searches.Count; index++)
                    {
                        var search = file.Searches[index];
                        var searchIndex = index;
                        <RadzenTabsItem @key="search" Text="@Truncate(search.Query.Query)" IconColor="@search.Color">
                            <RadzenStack class="search-tab-toolbar" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap=".65rem">
                                <label class="toggle"><RadzenCheckBox TValue="bool" Value="@file.FollowSearches[searchIndex]" Change="value => SetSearchFollow(file, searchIndex, value)" /> Follow</label>
                                <span>@search.Results.Count.ToString("N0") matches</span>
                            </RadzenStack>
                            @RenderView(file, search)
                        </RadzenTabsItem>
                    }
                </Tabs>
            </RadzenTabs>
        </RadzenStack>
    }
</RadzenStack>

@code {
    private static readonly MatchMode[] MatchModes = [MatchMode.Literal, MatchMode.Regex];
    private static readonly string[] Themes = ["material-dark", "material"];
    private static readonly UiDensity[] Densities = [UiDensity.Comfortable, UiDensity.Cozy, UiDensity.Compact];
    private static readonly LogFontSize[] FontSizes = [LogFontSize.Small, LogFontSize.Medium, LogFontSize.Large, LogFontSize.ExtraLarge];
    private readonly CancellationTokenSource _stop = new();
    private DotNetObjectReference<Home>? _browserReference;
    private Task? _pollTask;
    private string _query = string.Empty;
    private MatchMode _mode = MatchMode.Literal;
    private bool _caseSensitive;
    private string _color = "#f59e0b";
    private string? _searchError;
    private string? _fileError;
    private int _activeView;
    private bool _settingsOpen;
    private string _newLabel = string.Empty;
    private string _newLabelColor = "#f59e0b";
    private string _newExclusion = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        await State.RestoreAsync();
        ThemeService.SetTheme(State.Settings.Theme);
        _pollTask = DrainLoopAsync();
    }

    private void ToggleSettings() => _settingsOpen = !_settingsOpen;

    private async Task AddLabelAsync()
    {
        if (string.IsNullOrWhiteSpace(_newLabel))
            return;

        await UpdateSettingsAsync(State.Settings with
        {
            GlobalLabels = [.. State.Settings.GlobalLabels, new GlobalLabel { Text = _newLabel, Color = _newLabelColor }],
        });
        _newLabel = string.Empty;
    }

    private Task RemoveLabelAsync(int index) => UpdateSettingsAsync(State.Settings with
    {
        GlobalLabels = State.Settings.GlobalLabels.Where((_, current) => current != index).ToList(),
    });

    private Task UpdateLabelTextAsync(int index, string value) => UpdateSettingsAsync(State.Settings with
    {
        GlobalLabels = State.Settings.GlobalLabels.Select((label, current) => current == index ? new GlobalLabel { Text = value, Color = label.Color } : label).ToList(),
    });

    private Task UpdateLabelColorAsync(int index, string value) => UpdateSettingsAsync(State.Settings with
    {
        GlobalLabels = State.Settings.GlobalLabels.Select((label, current) => current == index ? new GlobalLabel { Text = label.Text, Color = value } : label).ToList(),
    });

    private async Task AddExclusionAsync()
    {
        if (string.IsNullOrWhiteSpace(_newExclusion))
            return;

        await UpdateSettingsAsync(State.Settings with { GlobalExcludeLabels = [.. State.Settings.GlobalExcludeLabels, _newExclusion] });
        _newExclusion = string.Empty;
    }

    private Task RemoveExclusionAsync(int index) => UpdateSettingsAsync(State.Settings with
    {
        GlobalExcludeLabels = State.Settings.GlobalExcludeLabels.Where((_, current) => current != index).ToList(),
    });

    private Task UpdateExclusionAsync(int index, string value) => UpdateSettingsAsync(State.Settings with
    {
        GlobalExcludeLabels = State.Settings.GlobalExcludeLabels.Select((label, current) => current == index ? value : label).ToList(),
    });

    private async Task UpdateThemeAsync(string theme)
    {
        await UpdateSettingsAsync(State.Settings with { Theme = theme });
        ThemeService.SetTheme(State.Settings.Theme);
    }

    private Task UpdateDensityAsync(UiDensity density) => UpdateSettingsAsync(State.Settings with { Density = density });

    private Task UpdateLogFontSizeAsync(LogFontSize size) => UpdateSettingsAsync(State.Settings with { LogFontSize = size });

    private Task UpdateSettingsAsync(AppSettings settings) => State.UpdateSettingsAsync(settings).AsTask();

    private async Task DrainLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
        try
        {
            while (await timer.WaitForNextTickAsync(_stop.Token))
            {
                State.DrainTailerEvents();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested)
        {
        }
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    private void SelectFile(FileTabState file)
    {
        State.SelectFile(file);
        _activeView = 0;
    }

    private async Task PickFilesAsync()
    {
        _fileError = null;
        _browserReference ??= DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("hexTailFilePicker.pick", _browserReference);
        }
        catch (JSException ex)
        {
            _fileError = ex.Message;
        }
        catch (Exception ex)
        {
            _fileError = $"Could not pick file: {ex.Message}";
        }
    }

    [JSInvokable]
    public async Task OnBrowserFileLines(string fileId, string fileName, string[] lines)
    {
        if (!State.Files.Any(file => file.Id == fileId))
            State.OpenBrowserFile(fileId, fileName, lines);
        else
            State.AppendBrowserLines(fileId, lines);

        await FollowTailAsync(fileId);
    }

    [JSInvokable]
    public void OnBrowserFileTruncated(string fileId) => State.TruncateBrowserFile(fileId);

    private async Task CloseFileAsync(FileTabState file)
    {
        await State.CloseFileAsync(file);
        if (file.IsSnapshot)
            await JS.InvokeVoidAsync("hexTailFilePicker.stop", file.Id);
    }

    private static string TabText(FileTabState file) => file.Error is null ? file.DisplayName : $"! {file.DisplayName}";

    private void SetSearchFollow(FileTabState file, int searchIndex, bool value)
    {
        file.FollowSearches[searchIndex] = value;
        _ = SaveAsync();
    }

    private async Task AddSearchAsync()
    {
        if (State.SelectedFile is not { } file || string.IsNullOrWhiteSpace(_query))
            return;

        try
        {
            State.AddSearch(file, _query, _mode, _caseSensitive, _color);
            await State.SaveAsync();
            _searchError = null;
            _query = string.Empty;
        }
        catch (ArgumentException ex)
        {
            _searchError = ex.Message;
        }
    }

    private async Task SaveAsync() => await State.SaveAsync();

    private RenderFragment RenderView(FileTabState file, Search? search) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", $"log-view density-{State.Settings.Density.ToString().ToLowerInvariant()} font-{State.Settings.LogFontSize.ToString().ToLowerInvariant()}");
        builder.AddAttribute(sequence++, "id", LogViewId(file, search));
        builder.AddAttribute(sequence++, "role", "log");
        builder.OpenComponent<Virtualize<Line>>(sequence++);
        builder.AddAttribute(sequence++, "Items", LinesFor(file, search));
        builder.AddAttribute(sequence++, "ItemSize", LogItemSize(State.Settings.LogFontSize));
        builder.AddAttribute(sequence++, "ChildContent", (RenderFragment<Line>)(line => rowBuilder =>
        {
            var rowSequence = 0;
            rowBuilder.OpenElement(rowSequence++, "div");
            rowBuilder.AddAttribute(rowSequence++, "class", "log-row");
            rowBuilder.OpenElement(rowSequence++, "button");
            rowBuilder.AddAttribute(rowSequence++, "class", "log-line");
            rowBuilder.AddAttribute(rowSequence++, "onclick", EventCallback.Factory.Create(this, () => SelectLine(file, line)));
            rowBuilder.AddAttribute(rowSequence++, "ondblclick", EventCallback.Factory.Create(this, () => ToggleExpanded(file, line)));
            rowBuilder.AddContent(rowSequence++, new MarkupString(RenderLine(file, line)));
            rowBuilder.CloseElement();
            if (line.ParsedFields is { Count: > 0 } && file.ExpandedLine == FindLineIndex(file, line))
            {
                rowBuilder.OpenElement(rowSequence++, "div");
                rowBuilder.AddAttribute(rowSequence++, "class", "parsed-fields");
                rowBuilder.AddContent(rowSequence++, string.Join("  ", line.ParsedFields.Select(field => $"{field.Key}={field.Value}")));
                rowBuilder.CloseElement();
            }
            rowBuilder.CloseElement();
        }));
        builder.CloseComponent();
        builder.CloseElement();
        if (file.ShowContext)
        {
            builder.OpenComponent<RadzenSplitter>(sequence++);
            builder.AddAttribute(sequence++, "Orientation", Orientation.Horizontal);
            builder.AddAttribute(sequence++, "Style", "height: 12rem");
            builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(splitterBuilder =>
            {
                var splitSequence = 0;
                splitterBuilder.OpenComponent<RadzenSplitterPane>(splitSequence++);
                splitterBuilder.AddAttribute(splitSequence++, "Size", "100%");
                splitterBuilder.AddAttribute(splitSequence++, "ChildContent", (RenderFragment)(paneBuilder =>
                {
                    var paneSequence = 0;
                    paneBuilder.OpenElement(paneSequence++, "div");
                    paneBuilder.AddAttribute(paneSequence++, "class", "context-empty");
                    paneBuilder.AddContent(paneSequence++, file.SelectedLine is null ? "Select a match to see context." : "Context is shown in the pane below.");
                    paneBuilder.CloseElement();
                }));
                splitterBuilder.CloseComponent();
                splitterBuilder.OpenComponent<RadzenSplitterPane>(splitSequence++);
                splitterBuilder.AddAttribute(splitSequence++, "ChildContent", (RenderFragment)(paneBuilder =>
                {
                    var paneSequence = 0;
                    foreach (var contextLine in file.ContextLines.Where(line => !State.Settings.Excludes(line.Raw)))
                    {
                        paneBuilder.OpenElement(paneSequence++, "div");
                        paneBuilder.AddAttribute(paneSequence++, "class", "context-line");
                        paneBuilder.AddContent(paneSequence++, contextLine.Raw);
                        paneBuilder.CloseElement();
                    }
                }));
                splitterBuilder.CloseComponent();
            }));
            builder.CloseComponent();
        }
    };

    private ICollection<Line> LinesFor(FileTabState file, Search? search) =>
        (search is null
            ? file.Buffer.Lines as ICollection<Line> ?? file.Buffer.Lines.ToList()
            : search.Results.Where(index => index >= 0 && index < file.Buffer.Count).Select(index => file.Buffer[index]).ToList())
        .Where(line => !State.Settings.Excludes(line.Raw))
        .ToList();

    private async Task FollowTailAsync(string fileId)
    {
        var file = State.SelectedFile;
        if (file?.Id != fileId)
            return;

        var follows = _activeView == 0
            ? file.FollowAll
            : _activeView - 1 < file.FollowSearches.Count && file.FollowSearches[_activeView - 1];
        if (follows)
            await JS.InvokeVoidAsync("hexTailFilePicker.scrollToEnd", $"log-view-{fileId}-{_activeView}");
    }

    private static string LogViewId(FileTabState file, Search? search) =>
        $"log-view-{file.Id}-{(search is null ? 0 : file.Searches.IndexOf(search) + 1)}";

    private void SelectLine(FileTabState file, Line line)
    {
        file.SelectedLine = FindLineIndex(file, line);
        StateHasChanged();
    }

    private void ToggleExpanded(FileTabState file, Line line)
    {
        var index = FindLineIndex(file, line);
        file.ExpandedLine = file.ExpandedLine == index ? null : index;
        StateHasChanged();
    }

    private static int FindLineIndex(FileTabState file, Line line)
    {
        for (var i = 0; i < file.Buffer.Count; i++)
        {
            if (ReferenceEquals(file.Buffer[i], line))
                return i;
        }

        return -1;
    }

    private string RenderLine(FileTabState file, Line line)
    {
        var ranges = file.Searches
            .SelectMany(search => search.GetHighlights(line).Select(range => (range.Start, range.Length, search.Color)))
            .Concat(State.Settings.GetLabelHighlights(line.Raw).Select(range => (range.Start, range.Length, range.Color)))
            .Where(range => range.Start >= 0 && range.Length > 0 && range.Start + range.Length <= line.Raw.Length)
            .OrderBy(range => range.Start)
            .ThenByDescending(range => range.Length)
            .ToList();
        if (ranges.Count == 0)
            return WebUtility.HtmlEncode(line.Raw);

        var output = new System.Text.StringBuilder();
        var cursor = 0;
        foreach (var range in ranges)
        {
            if (range.Start < cursor)
                continue;
            output.Append(WebUtility.HtmlEncode(line.Raw[cursor..range.Start]));
            output.Append("<mark style=\"background:");
            output.Append(WebUtility.HtmlEncode(range.Color));
            output.Append("\">");
            output.Append(WebUtility.HtmlEncode(line.Raw.Substring(range.Start, range.Length)));
            output.Append("</mark>");
            cursor = range.Start + range.Length;
        }

        output.Append(WebUtility.HtmlEncode(line.Raw[cursor..]));
        return output.ToString();
    }

    private static string Truncate(string text) => text.Length > 24 ? $"{text[..21]}..." : text;

    private static float LogItemSize(LogFontSize size) => size switch
    {
        LogFontSize.Small => 22f,
        LogFontSize.Large => 28f,
        LogFontSize.ExtraLarge => 32f,
        _ => 24f,
    };

    public async ValueTask DisposeAsync()
    {
        State.Changed -= OnStateChanged;
        _stop.Cancel();
        if (_pollTask is not null)
            await _pollTask;
        try
        {
            await JS.InvokeVoidAsync("hexTailFilePicker.stopAll");
        }
        catch (JSException)
        {
        }
        _browserReference?.Dispose();
        _stop.Dispose();
    }
}
