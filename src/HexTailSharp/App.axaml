<Application
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="HexTailSharp.App"
>
  <Application.Resources>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#090D12" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#101722" />
    <SolidColorBrush x:Key="ToolbarBrush" Color="#0D141E" />
    <SolidColorBrush x:Key="BorderBrush" Color="#263449" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6EDF7" />
    <SolidColorBrush x:Key="MutedBrush" Color="#91A0B5" />
    <SolidColorBrush x:Key="AccentBrush" Color="#28D7FE" />
    <SolidColorBrush x:Key="SelectedTabBrush" Color="#28D7FE" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#39E58C" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF667A" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#2A1118" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FFD5DC" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <StyleInclude Source="avares://HexTailSharp/Styles/CyberTail.axaml" />
    <Style Selector="Button">
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    </Style>
  </Application.Styles>
</Application>
