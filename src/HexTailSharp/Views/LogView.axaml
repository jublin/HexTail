<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:HexTailSharp.ViewModels"
  xmlns:views="using:HexTailSharp.Views"
  x:Class="HexTailSharp.Views.LogView"
  x:DataType="vm:LogViewViewModel"
>
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource SurfaceBrush}">
    <Grid
      Grid.Row="0"
      ColumnDefinitions="*,Auto"
    >
      <views:SearchBar DataContext="{Binding Workspace}" />
      <StackPanel
        Grid.Column="1"
        Orientation="Horizontal"
        Spacing="8"
        Margin="0,4,12,4"
        VerticalAlignment="Center"
      >
        <CheckBox
          Content="Follow"
          FontSize="12"
          Padding="{Binding Workspace.Settings.SecondaryPadding}"
          MinHeight="{Binding Workspace.Settings.SecondaryControlHeight}"
          IsChecked="{Binding IsFollowing, Mode=TwoWay}"
        />
        <CheckBox
          Content="Show Inline"
          FontSize="12"
          Padding="{Binding Workspace.Settings.SecondaryPadding}"
          MinHeight="{Binding Workspace.Settings.SecondaryControlHeight}"
          IsChecked="{Binding ShowContext, Mode=TwoWay}"
        />
        <TextBlock
          Text="{Binding MatchSummary}"
          VerticalAlignment="Center"
          Foreground="{DynamicResource MutedBrush}"
        />
      </StackPanel>
    </Grid>
    <Grid x:Name="LogLayout" Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="{Binding ContextSplitterHeight}" />
        <RowDefinition Height="{Binding ContextRowHeight}" />
      </Grid.RowDefinitions>
      <ListBox
        x:Name="LogList"
        Grid.Row="0"
        Background="{DynamicResource SurfaceBrush}"
        BorderThickness="0"
        ItemsSource="{Binding Lines}"
      >
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LogLineViewModel">
            <views:LogLineView />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <GridSplitter
        Grid.Row="1"
        Background="{DynamicResource BorderBrush}"
        ResizeDirection="Rows"
        ResizeBehavior="PreviousAndNext"
        ShowsPreview="False"
        IsVisible="{Binding ContextVisible}"
      />
      <ListBox
        x:Name="ContextList"
        Grid.Row="2"
        Background="{DynamicResource RaisedBrush}"
        BorderThickness="0"
        ItemsSource="{Binding ContextLines}"
        IsVisible="{Binding ContextVisible}"
      >
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LogLineViewModel">
            <views:LogLineView />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock
        Grid.Row="2"
        Text="No lines to show."
        Foreground="{DynamicResource MutedBrush}"
        FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
        Margin="12,8"
        IsVisible="{Binding ContextEmptyVisible}"
      />
    </Grid>
  </Grid>
</UserControl>
