<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:HexTailSharp.ViewModels"
  xmlns:i="using:Avalonia.Xaml.Interactivity"
  xmlns:core="using:Avalonia.Xaml.Interactions.Core"
  xmlns:events="using:Avalonia.Xaml.Interactions.Events"
  x:Class="HexTailSharp.Views.SearchBar"
  x:DataType="vm:MainWindowViewModel"
>
  <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,10" IsVisible="{Binding HasFile}">
    <Grid ColumnDefinitions="*" MinWidth="240">
      <TextBox x:Name="QueryBox" Name="QueryBox" Text="{Binding Query, Mode=TwoWay}" PlaceholderText="Search this file" Padding="12,0,42,0">
        <i:Interaction.Behaviors>
          <events:KeyDownEventTrigger>
            <core:InvokeCommandAction Command="{Binding AddSearchOnKeyCommand}" PassEventArgsToCommand="True" />
          </events:KeyDownEventTrigger>
        </i:Interaction.Behaviors>
      </TextBox>
      <ToggleButton
        x:Name="CaseToggle"
        Name="CaseToggle"
        HorizontalAlignment="Right"
        Margin="0,2,4,2"
        Padding="8,0"
        Content="Aa"
        IsChecked="{Binding CaseSensitive, Mode=TwoWay}"
        ToolTip.Tip="Match case"
        AutomationProperties.Name="Match case"
      />
    </Grid>
    <ColorPicker Grid.Column="1" Color="{Binding SearchColor, Mode=TwoWay}" Width="48" IsAlphaEnabled="False" ToolTip.Tip="Search highlight color" />
    <Button x:Name="AddSearchButton" Name="AddSearchButton" Grid.Column="2" Classes="primary" Content="Add Search" Command="{Binding AddSearchCommand}" />
  </Grid>
</UserControl>
