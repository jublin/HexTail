<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:HexTailSharp.ViewModels"
  xmlns:ic="https://github.com/projektanker/icons.avalonia"
  x:Class="HexTailSharp.Views.SettingsPanel"
  x:DataType="vm:MainWindowViewModel"
>
  <Border
    Classes="settings-modal"
    Width="1600"
    Height="920"
    MinWidth="1200"
    MinHeight="820"
    MaxWidth="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=Window}}"
    MaxHeight="{Binding Bounds.Height, RelativeSource={RelativeSource AncestorType=Window}}"
    Margin="24"
  >
    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
        <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button
          x:Name="SettingsCloseButton"
          Name="SettingsCloseButton"
          Grid.Column="1"
          Classes="icon tab-close settings-close"
          Command="{Binding ToggleSettingsCommand}"
          ToolTip.Tip="Close settings"
          AutomationProperties.Name="Close settings"
        >
          <ic:Icon Value="mdi-close" />
        </Button>
      </Grid>
      <TabControl
        Grid.Row="1"
        SelectedIndex="{Binding Settings.SectionIndex, Mode=TwoWay}"
        TabStripPlacement="Top"
      >
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ic:Icon Value="mdi-tag-outline" />
              <TextBlock Text="Labels &amp; Exclusions" />
            </StackPanel>
          </TabItem.Header>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,16,0,0">
              <Border Classes="settings-section">
                <StackPanel Spacing="10">
                  <TextBlock Text="Global Labels" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="Highlight case-insensitive text across every log view." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                  <Grid ColumnDefinitions="*,64,144,48" ColumnSpacing="8">
                    <TextBlock Text="LABEL TEXT" Classes="elastic-form-label" />
                    <TextBlock Grid.Column="1" Text="COLOR" Classes="elastic-form-label" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="SHOW IN OPEN FILE" Classes="elastic-form-label" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Text="ACTIONS" Classes="elastic-form-label" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Settings.Labels}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LabelSettingViewModel">
                        <Grid ColumnDefinitions="*,64,144,48" ColumnSpacing="8" Margin="0,2">
                          <TextBox Text="{Binding Text, Mode=TwoWay}" PlaceholderText="Text to highlight" />
                          <ColorPicker Grid.Column="1" Color="{Binding Color, Mode=TwoWay}" Width="48" HorizontalAlignment="Center" IsAlphaEnabled="False" />
                          <CheckBox Grid.Column="2" IsChecked="{Binding ShowInOpenFile, Mode=TwoWay}" HorizontalAlignment="Center" ToolTip.Tip="Show matching search tab in open files and Elastic views" />
                          <Button Grid.Column="3" Classes="icon destructive" HorizontalAlignment="Center" ToolTip.Tip="Remove label" Command="{Binding $parent[ItemsControl].DataContext.Settings.RemoveLabelCommand}" CommandParameter="{Binding}">
                            <ic:Icon Value="mdi-delete-outline" />
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid ColumnDefinitions="*,64,144,48" ColumnSpacing="8">
                    <TextBox Text="{Binding Settings.NewLabelText, Mode=TwoWay}" PlaceholderText="Text to highlight" />
                    <ColorPicker Grid.Column="1" Color="{Binding Settings.NewLabelColor, Mode=TwoWay}" Width="48" HorizontalAlignment="Center" IsAlphaEnabled="False" />
                    <CheckBox Grid.Column="2" IsEnabled="False" IsChecked="True" HorizontalAlignment="Center" />
                    <Button x:Name="AddLabelButton" Grid.Column="3" Classes="icon" HorizontalAlignment="Center" ToolTip.Tip="Add label" Command="{Binding Settings.AddLabelCommand}">
                      <ic:Icon Value="mdi-plus" />
                    </Button>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="settings-section">
                <StackPanel Spacing="10">
                  <TextBlock Text="Exclusions" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="Matching lines remain buffered but stay hidden from log and context views." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Settings.Exclusions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ExclusionSettingViewModel">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                          <TextBox Text="{Binding Text, Mode=TwoWay}" PlaceholderText="Text to hide" />
                          <Button Grid.Column="1" Classes="icon destructive" ToolTip.Tip="Remove exclusion" Command="{Binding $parent[ItemsControl].DataContext.Settings.RemoveExclusionCommand}" CommandParameter="{Binding}">
                            <ic:Icon Value="mdi-delete-outline" />
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding Settings.NewExclusionText, Mode=TwoWay}" PlaceholderText="Text to hide" />
                    <Button x:Name="AddExclusionButton" Grid.Column="1" Classes="icon" ToolTip.Tip="Add exclusion" Command="{Binding Settings.AddExclusionCommand}">
                      <ic:Icon Value="mdi-plus" />
                    </Button>
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>
          </ScrollViewer>
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ic:Icon Value="mdi-palette-outline" />
              <TextBlock Text="Appearance" />
            </StackPanel>
          </TabItem.Header>
          <Border Classes="settings-section" Margin="0,16,0,0">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="28">
              <StackPanel Spacing="10">
                <TextBlock Text="Density" />
                <ComboBox x:Name="DensityBox" HorizontalContentAlignment="Left" ItemsSource="{Binding Settings.DensityOptions}" SelectedItem="{Binding Settings.Density, Mode=TwoWay}" />
                <TextBlock Text="Log font size" />
                <ComboBox x:Name="FontSizeBox" HorizontalContentAlignment="Left" ItemsSource="{Binding Settings.FontSizeOptions}" SelectedItem="{Binding Settings.FontSize, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="10">
                <TextBlock Text="Theme" />
                <ComboBox x:Name="ThemeBox" ItemsSource="{Binding Settings.ThemeOptions}" SelectedItem="{Binding Settings.SelectedTheme, Mode=TwoWay}" DisplayMemberBinding="{Binding DisplayName}" />
                <TextBlock Text="Time zone" />
                <ComboBox ItemsSource="{Binding Settings.TimeZoneModes}" SelectedItem="{Binding Settings.TimeZoneMode, Mode=TwoWay}" HorizontalContentAlignment="Left" />
              </StackPanel>
            </Grid>
          </Border>
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ic:Icon Value="mdi-database-outline" />
              <TextBlock Text="Elastic" />
            </StackPanel>
          </TabItem.Header>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" Margin="0,16,0,0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Elastic servers" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button
                  x:Name="AddElasticServerButton"
                  Grid.Column="1"
                  Content="Add server"
                  Command="{Binding Settings.AddElasticConnectionCommand}"
                  Classes="primary"
                />
              </Grid>
              <ListBox ItemsSource="{Binding Settings.ElasticConnections}" Background="Transparent" BorderThickness="0">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ElasticConnectionEditorViewModel">
                    <Expander
                      Classes="elastic-card"
                      IsExpanded="True"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                    >
                      <Expander.Header>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                          <ic:Icon Value="mdi-circle" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                          <Button Grid.Column="2" Classes="icon" ToolTip.Tip="Save server" Command="{Binding SaveCommand}">
                            <ic:Icon Value="mdi-content-save-outline" />
                          </Button>
                          <Button
                            Grid.Column="3"
                            Classes="icon destructive"
                            ToolTip.Tip="Remove server"
                            Command="{Binding $parent[ItemsControl].DataContext.Settings.RemoveElasticConnectionCommand}"
                            CommandParameter="{Binding}"
                          >
                            <ic:Icon Value="mdi-delete-outline" />
                          </Button>
                        </Grid>
                      </Expander.Header>
                      <StackPanel Spacing="12" Margin="0,12,0,0">
                        <Grid ColumnDefinitions="2*,.7*,1*,1*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                          <TextBlock Text="Kibana URL" Classes="elastic-form-label" />
                          <TextBlock Grid.Column="1" Text="Login method" Classes="elastic-form-label" />
                          <TextBlock Grid.Column="2" Text="Username" Classes="elastic-form-label" />
                          <TextBlock Grid.Column="3" Text="Password" Classes="elastic-form-label" />
                          <TextBox Grid.Row="1" Text="{Binding KibanaUrl, Mode=TwoWay}" PlaceholderText="https://kibana.example.com" />
                          <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AuthModes}" SelectedItem="{Binding AuthMode, Mode=TwoWay}" HorizontalContentAlignment="Left" />
                          <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Username, Mode=TwoWay}" IsVisible="{Binding IsBasic}" PlaceholderText="Username" />
                          <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Secret, Mode=TwoWay}" IsVisible="{Binding IsAuthenticated}" PasswordChar="•" PlaceholderText="Password or API key" />
                          <TextBlock Grid.Row="2" Text="Elasticsearch URL" Classes="elastic-form-label" />
                          <TextBox Grid.Row="3" Grid.ColumnSpan="4" Text="{Binding ElasticsearchUrl, Mode=TwoWay}" PlaceholderText="https://elastic.example.com" />
                        </Grid>
                        <TextBlock Text="{Binding Error}" Classes="error" TextWrapping="Wrap" />
                        <Border Classes="elastic-views">
                          <Grid RowDefinitions="Auto,*">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="Views" FontWeight="SemiBold" VerticalAlignment="Center" />
                              <Button
                                Grid.Column="1"
                                Content="Add view"
                                Command="{Binding AddViewCommand}"
                              />
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Views}" Margin="0,10,0,0" Background="Transparent" BorderThickness="0">
                              <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                  <Setter Property="Padding" Value="0" />
                                </Style>
                              </ListBox.Styles>
                              <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ElasticViewEditorViewModel">
                                  <Expander Classes="elastic-view-card" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Classes="elastic-status"><TextBlock Text="{Binding Status}" /></Border>
                                        <Button Grid.Column="2" Classes="icon destructive" ToolTip.Tip="Remove view" Command="{Binding $parent[ListBox].DataContext.RemoveViewCommand}" CommandParameter="{Binding}">
                                          <ic:Icon Value="mdi-delete-outline" />
                                        </Button>
                                      </Grid>
                                    </Expander.Header>
                                    <StackPanel Spacing="10" Margin="0,10,0,0">
                                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="View name" />
                                        <Button Grid.Column="1" Content="Test connection" Command="{Binding TestConnectionCommand}" Classes="primary" />
                                      </Grid>
                                      <TextBlock Text="{Binding Error}" Classes="error" TextWrapping="Wrap" />
                                      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <StackPanel Spacing="4">
                                          <TextBlock Text="Data view" Classes="elastic-form-label" />
                                          <ComboBox ItemsSource="{Binding DataViews}" SelectedValue="{Binding SelectedDataViewId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" DisplayMemberBinding="{Binding Title}" PlaceholderText="Select a data view" HorizontalContentAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                          <TextBlock Text="Field" Classes="elastic-form-label" />
                                          <AutoCompleteBox ItemsSource="{Binding FieldNames}" SelectedItem="{Binding ServerField, Mode=TwoWay}" PlaceholderText="Filter field" FilterMode="Contains" MinimumPrefixLength="0" />
                                        </StackPanel>
                                      </Grid>
                                      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <StackPanel Spacing="4">
                                          <TextBlock Text="Value" Classes="elastic-form-label" />
                                          <TextBox Text="{Binding FilterValue, Mode=TwoWay}" PlaceholderText="Filter value" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                          <TextBlock Text="Namespace field" Classes="elastic-form-label" />
                                          <AutoCompleteBox ItemsSource="{Binding FieldNames}" SelectedItem="{Binding NamespaceField, Mode=TwoWay}" PlaceholderText="Optional namespace field" FilterMode="Contains" MinimumPrefixLength="0" />
                                        </StackPanel>
                                      </Grid>
                                      <TextBlock Text="Fields to display" Classes="elastic-form-label" />
                                      <ItemsControl ItemsSource="{Binding VisibleFields}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                          <DataTemplate x:DataType="vm:ElasticFieldOptionViewModel">
                                            <CheckBox Classes="elastic-field-chip" Content="{Binding Name}" IsChecked="{Binding IsOutput, Mode=TwoWay}" />
                                          </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                      </ItemsControl>
                                      <TextBox Text="{Binding OutputFieldQuery, Mode=TwoWay}" PlaceholderText="Search fields…" />
                                      <ItemsControl ItemsSource="{Binding Sources}">
                                        <ItemsControl.ItemTemplate>
                                          <DataTemplate x:DataType="vm:ElasticSourceSettingViewModel">
                                            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                                              <TextBox Text="{Binding ServerValue, Mode=TwoWay}" PlaceholderText="Identity value" />
                                              <TextBox Grid.Column="1" Text="{Binding NamespaceValue, Mode=TwoWay}" PlaceholderText="Namespace value" />
                                              <Button Grid.Column="2" Classes="icon destructive" ToolTip.Tip="Remove source" Command="{Binding $parent[ItemsControl].DataContext.RemoveSourceCommand}" CommandParameter="{Binding}"><ic:Icon Value="mdi-delete-outline" /></Button>
                                            </Grid>
                                          </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                      </ItemsControl>
                                      <Button Content="Add source" Command="{Binding AddSourceCommand}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                  </Expander>
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>
                          </Grid>
                        </Border>
                      </StackPanel>
                    </Expander>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
      <TextBlock
        x:Name="SettingsSaveError"
        Grid.Row="2"
        Classes="error"
        Margin="0,12,0,0"
        TextWrapping="Wrap"
        IsVisible="{Binding Settings.HasSaveError}"
        Text="{Binding Settings.SaveError}"
      />
      <TextBlock
        Grid.Row="3"
        Margin="0,8,0,0"
        Foreground="{DynamicResource MutedBrush}"
        IsVisible="{Binding Settings.IsSaving}"
        Text="Saving…"
      />
    </Grid>
  </Border>
</UserControl>
