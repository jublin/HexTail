<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:HexTailSharp.ViewModels"
  xmlns:ic="https://github.com/projektanker/icons.avalonia"
  x:Class="HexTailSharp.Views.SettingsPanel"
  x:DataType="vm:MainWindowViewModel"
>
  <Border Classes="settings-sheet" Margin="12">
    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
        <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button
          x:Name="SettingsCloseButton"
          Name="SettingsCloseButton"
          Grid.Column="1"
          Classes="icon tab-close settings-close"
          Command="{Binding ToggleSettingsCommand}"
          ToolTip.Tip="Close settings"
          AutomationProperties.Name="Close settings"
        >
          <ic:Icon Value="mdi-close" />
        </Button>
      </Grid>
      <TabControl
        Grid.Row="1"
        SelectedIndex="{Binding Settings.SectionIndex, Mode=TwoWay}"
        TabStripPlacement="Left"
      >
        <TabItem Header="Global Labels">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" Margin="0,12,0,0">
              <TextBlock
                Text="Highlight case-insensitive text across every log view."
                Foreground="{DynamicResource MutedBrush}"
                TextWrapping="Wrap"
              />
              <ItemsControl ItemsSource="{Binding Settings.Labels}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LabelSettingViewModel">
                    <Grid ColumnDefinitions=".8*,.1*,.1*" Margin="0,2">
                      <TextBox
                        Text="{Binding Text, Mode=TwoWay}"
                        PlaceholderText="Text to highlight"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                      />
                      <ColorPicker
                        Grid.Column="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Color="{Binding Color, Mode=TwoWay}"
                        Width="48"
                        IsAlphaEnabled="False"
                      />
                      <Button
                        Grid.Column="2"
                        Classes="icon"
                        ToolTip.Tip="Remove label"
                        Command="{Binding $parent[ItemsControl].DataContext.Settings.RemoveLabelCommand}"
                        CommandParameter="{Binding}"
                      >
                        <ic:Icon Value="mdi-close" FontSize="18" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions=".8*,.1*,.1*">
                <TextBox
                  Text="{Binding Settings.NewLabelText, Mode=TwoWay}"
                  PlaceholderText="Text to highlight"
                />
                <ColorPicker
                  Grid.Column="1"
                  Color="{Binding Settings.NewLabelColor, Mode=TwoWay}"
                  Width="48"
                  IsAlphaEnabled="False"
                />
                <Button
                  x:Name="AddLabelButton"
                  Name="AddLabelButton"
                  Grid.Column="2"
                  Classes="icon"
                  ToolTip.Tip="Add label"
                  Command="{Binding Settings.AddLabelCommand}"
                >
                  <ic:Icon Value="mdi-plus" FontSize="18" />
                </Button>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Exclusions">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" Margin="0,12,0,0">
              <TextBlock
                Text="Matching lines remain buffered but stay hidden from log and context views."
                Foreground="{DynamicResource MutedBrush}"
                TextWrapping="Wrap"
              />
              <ItemsControl ItemsSource="{Binding Settings.Exclusions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ExclusionSettingViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                      <TextBox Text="{Binding Text, Mode=TwoWay}" PlaceholderText="Text to hide" />
                      <Button
                        Grid.Column="1"
                        Classes="icon"
                        ToolTip.Tip="Remove exclusion"
                        Command="{Binding $parent[ItemsControl].DataContext.Settings.RemoveExclusionCommand}"
                        CommandParameter="{Binding}"
                      >
                        <ic:Icon Value="mdi-close" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox
                  Text="{Binding Settings.NewExclusionText, Mode=TwoWay}"
                  PlaceholderText="Text to hide"
                />
                <Button
                  x:Name="AddExclusionButton"
                  Name="AddExclusionButton"
                  Grid.Column="1"
                  Classes="icon"
                  ToolTip.Tip="Add exclusion"
                  Command="{Binding Settings.AddExclusionCommand}"
                >
                  <ic:Icon Value="mdi-plus" />
                </Button>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Display">
          <StackPanel Spacing="12" Margin="0,12,0,0">
            <TextBlock Text="Density" />
            <ComboBox
              x:Name="DensityBox"
              HorizontalContentAlignment="Left"
              HorizontalAlignment="Stretch"
              Name="DensityBox"
              ItemsSource="{Binding Settings.DensityOptions}"
              SelectedItem="{Binding Settings.Density, Mode=TwoWay}"
            />
            <TextBlock Text="Log font size" />
            <ComboBox
              HorizontalContentAlignment="Left"
              HorizontalAlignment="Stretch"
              x:Name="FontSizeBox"
              Name="FontSizeBox"
              ItemsSource="{Binding Settings.FontSizeOptions}"
              SelectedItem="{Binding Settings.FontSize, Mode=TwoWay}"
            />
          </StackPanel>
        </TabItem>
        <TabItem Header="Appearance">
          <StackPanel Spacing="12" Margin="0,12,0,0">
            <TextBlock Text="Theme" />
            <ComboBox
              x:Name="ThemeBox"
              Name="ThemeBox"
              ItemsSource="{Binding Settings.ThemeOptions}"
              SelectedItem="{Binding Settings.SelectedTheme, Mode=TwoWay}"
              DisplayMemberBinding="{Binding DisplayName}"
            />
          </StackPanel>
        </TabItem>
        <TabItem Header="Elastic">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8" Margin="0,12,0,0">
              <TextBlock Text="Configured connections" FontWeight="SemiBold" />
              <Button
                Content="Add connection"
                Command="{Binding Settings.AddElasticConnectionCommand}"
              />
              <ItemsControl ItemsSource="{Binding Settings.ElasticConnections}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ElasticConnectionEditorViewModel">
                    <Border Classes="elastic-card" Margin="0,4,0,8">
                      <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBox
                            Text="{Binding Name, Mode=TwoWay}"
                            PlaceholderText="Connection name"
                            Classes="elastic-title"
                          />
                          <Button
                            Grid.Column="1"
                            Content="Remove"
                            Command="{Binding $parent[ItemsControl].DataContext.Settings.RemoveElasticConnectionCommand}"
                            CommandParameter="{Binding}"
                          />
                        </Grid>

                        <Border Classes="elastic-section">
                          <StackPanel Spacing="8">
                            <TextBlock Text="Connection" Classes="section-label" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                              <TextBox
                                Text="{Binding KibanaUrl, Mode=TwoWay}"
                                PlaceholderText="Kibana URL · https://host:5601"
                              />
                              <TextBox
                                Grid.Column="1"
                                Text="{Binding ElasticsearchUrl, Mode=TwoWay}"
                                PlaceholderText="Elasticsearch URL · https://host:9200"
                              />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Button
                                Content="Test connection"
                                Command="{Binding TestConnectionCommand}"
                                Classes="primary"
                              />
                              <Border Classes="elastic-status">
                                <TextBlock Text="{Binding Status}" />
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Error}" Classes="error" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>

                        <Border Classes="elastic-section">
                          <StackPanel Spacing="8">
                            <TextBlock Text="Authentication" Classes="section-label" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                              <ComboBox
                                ItemsSource="{Binding AuthModes}"
                                SelectedItem="{Binding AuthMode, Mode=TwoWay}"
                                HorizontalContentAlignment="Left"
                              />
                              <TextBox
                                Grid.Column="1"
                                Text="{Binding Username, Mode=TwoWay}"
                                IsVisible="{Binding IsBasic}"
                                PlaceholderText="Username"
                              />
                            </Grid>
                            <TextBox
                              Text="{Binding Secret, Mode=TwoWay}"
                              IsVisible="{Binding IsAuthenticated}"
                              PasswordChar="•"
                              PlaceholderText="Password or API key"
                            />
                          </StackPanel>
                        </Border>

                        <Border Classes="elastic-section">
                          <StackPanel Spacing="8">
                            <TextBlock Text="Data view" Classes="section-label" />
                            <ComboBox
                              ItemsSource="{Binding DataViews}"
                              SelectedValue="{Binding SelectedDataViewId, Mode=TwoWay}"
                              SelectedValueBinding="{Binding Id}"
                              DisplayMemberBinding="{Binding Title}"
                              PlaceholderText="Select a data view after testing the connection"
                              HorizontalContentAlignment="Left"
                            />
                          </StackPanel>
                        </Border>

                        <Border Classes="elastic-section">
                          <StackPanel Spacing="8">
                            <TextBlock Text="Filter fields" Classes="section-label" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                              <AutoCompleteBox
                                ItemsSource="{Binding FieldNames}"
                                SelectedItem="{Binding ServerField, Mode=TwoWay}"
                                PlaceholderText="Identity field · e.g. ident"
                                FilterMode="Contains"
                                MinimumPrefixLength="0"
                              />
                              <AutoCompleteBox
                                Grid.Column="1"
                                ItemsSource="{Binding FieldNames}"
                                SelectedItem="{Binding NamespaceField, Mode=TwoWay}"
                                PlaceholderText="Namespace field · e.g. environment"
                                FilterMode="Contains"
                                MinimumPrefixLength="0"
                              />
                            </Grid>
                            <TextBlock
                              Text="Choose the fields used to identify and filter each source."
                              Foreground="{DynamicResource MutedBrush}"
                              TextWrapping="Wrap"
                            />
                          </StackPanel>
                        </Border>

                        <Border Classes="elastic-section">
                          <StackPanel Spacing="8">
                            <TextBlock Text="Output fields" Classes="section-label" />
                            <ItemsControl ItemsSource="{Binding Fields}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ElasticFieldOptionViewModel">
                                  <CheckBox
                                    Content="{Binding Name}"
                                    IsChecked="{Binding IsOutput, Mode=TwoWay}"
                                  />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>

                        <Border Classes="elastic-section">
                          <StackPanel Spacing="8">
                            <TextBlock Text="Sources" Classes="section-label" />
                            <TextBlock
                              Text="Add the identity and namespace values used to filter this data view."
                              Foreground="{DynamicResource MutedBrush}"
                              TextWrapping="Wrap"
                            />
                            <ItemsControl ItemsSource="{Binding Sources}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ElasticSourceSettingViewModel">
                                  <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                                    <TextBox
                                      Text="{Binding ServerValue, Mode=TwoWay}"
                                      PlaceholderText="Identity value · e.g. app1"
                                    />
                                    <TextBox
                                      Grid.Column="1"
                                      Text="{Binding NamespaceValue, Mode=TwoWay}"
                                      PlaceholderText="Namespace value"
                                    />
                                    <Button
                                      Grid.Column="2"
                                      Content="Remove"
                                      Command="{Binding $parent[ItemsControl].DataContext.RemoveSourceCommand}"
                                      CommandParameter="{Binding}"
                                    />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button
                              Content="Add source"
                              Command="{Binding AddSourceCommand}"
                              HorizontalAlignment="Left"
                            />
                          </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                          <Button Content="Save connection" Command="{Binding SaveCommand}" Classes="primary" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock
                Text="Remote sources are selected from the toolbar."
                Foreground="{DynamicResource MutedBrush}"
              />
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
      <TextBlock
        x:Name="SettingsSaveError"
        Grid.Row="2"
        Classes="error"
        Margin="0,12,0,0"
        TextWrapping="Wrap"
        IsVisible="{Binding Settings.HasSaveError}"
        Text="{Binding Settings.SaveError}"
      />
      <TextBlock
        Grid.Row="3"
        Margin="0,8,0,0"
        Foreground="{DynamicResource MutedBrush}"
        IsVisible="{Binding Settings.IsSaving}"
        Text="Saving…"
      />
    </Grid>
  </Border>
</UserControl>
