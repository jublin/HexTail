<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:HexTailSharp.ViewModels"
  x:Class="HexTailSharp.Views.SettingsPanel"
  x:DataType="vm:MainWindowViewModel"
>
  <Grid RowDefinitions="Auto,*,Auto,Auto" Background="{DynamicResource CyberRaisedBrush}" Margin="16">
    <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
    <TabControl Grid.Row="1" SelectedIndex="{Binding Settings.SectionIndex, Mode=TwoWay}">
      <TabItem Header="Labels">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10" Margin="0,12,0,0">
            <TextBlock Text="Highlight case-insensitive text across every log view." Foreground="{DynamicResource CyberMutedBrush}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Settings.Labels}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LabelSettingViewModel">
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                    <TextBox Text="{Binding Text, Mode=TwoWay}" PlaceholderText="Text to highlight" />
                    <ColorPicker Grid.Column="1" Color="{Binding Color, Mode=TwoWay}" Width="48" IsAlphaEnabled="False" />
                    <Button Grid.Column="2" Content="×" ToolTip.Tip="Remove label" Command="{Binding $parent[ItemsControl].DataContext.Settings.RemoveLabelCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBox Text="{Binding Settings.NewLabelText, Mode=TwoWay}" PlaceholderText="Text to highlight" />
              <ColorPicker Grid.Column="1" Color="{Binding Settings.NewLabelColor, Mode=TwoWay}" Width="48" IsAlphaEnabled="False" />
              <Button x:Name="AddLabelButton" Name="AddLabelButton" Grid.Column="2" Content="+" ToolTip.Tip="Add label" Command="{Binding Settings.AddLabelCommand}" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Exclusions">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10" Margin="0,12,0,0">
            <TextBlock Text="Matching lines remain buffered but stay hidden from log and context views." Foreground="{DynamicResource CyberMutedBrush}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Settings.Exclusions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ExclusionSettingViewModel">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBox Text="{Binding Text, Mode=TwoWay}" PlaceholderText="Text to hide" />
                    <Button Grid.Column="1" Content="×" ToolTip.Tip="Remove exclusion" Command="{Binding $parent[ItemsControl].DataContext.Settings.RemoveExclusionCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding Settings.NewExclusionText, Mode=TwoWay}" PlaceholderText="Text to hide" />
              <Button x:Name="AddExclusionButton" Name="AddExclusionButton" Grid.Column="1" Content="+" ToolTip.Tip="Add exclusion" Command="{Binding Settings.AddExclusionCommand}" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Display">
        <StackPanel Spacing="12" Margin="0,12,0,0">
          <TextBlock Text="Density" />
          <ComboBox x:Name="DensityBox" Name="DensityBox" ItemsSource="{Binding Settings.DensityOptions}" SelectedItem="{Binding Settings.Density, Mode=TwoWay}" />
          <TextBlock Text="Log font size" />
          <ComboBox x:Name="FontSizeBox" Name="FontSizeBox" ItemsSource="{Binding Settings.FontSizeOptions}" SelectedItem="{Binding Settings.FontSize, Mode=TwoWay}" />
        </StackPanel>
      </TabItem>
    </TabControl>
    <TextBlock x:Name="SettingsSaveError" Grid.Row="2" Classes="error" Margin="0,12,0,0" TextWrapping="Wrap" IsVisible="{Binding Settings.HasSaveError}" Text="{Binding Settings.SaveError}" />
    <TextBlock Grid.Row="3" Margin="0,8,0,0" Foreground="{DynamicResource CyberMutedBrush}" IsVisible="{Binding Settings.IsSaving}" Text="Saving…" />
  </Grid>
</UserControl>
